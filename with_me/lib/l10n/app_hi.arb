  "scriptHomeReset01": "नमस्ते। मैं यहाँ आपके साथ हूँ।",
  "scriptHomeReset02": "कभी-कभी घर, घर जैसा नहीं लगता… बहुत शोर, बहुत भागदौड़, बहुत कुछ। इन दस मिनटों के लिए, चलिए आपके भीतर एक शांत जगह बनाते हैं।",
  "scriptHomeReset03": "ऐसी स्थिति ढूँढ़ें जिसमें आपके शरीर को सहारा मिले। पैर ज़मीन पर सपाट। हाथ जहाँ टिकना चाहें, वहीं टिके रहें।",
  "scriptHomeReset04": "अब अपनी आँखों को सामने कोई एक छोटा-सा बिंदु ढूँढ़ने दें… और बस अपनी नज़र वहीं टिका दें।",
  "scriptHomeReset05": "उसे देखते रहें… और ध्यान दें कि आपकी पलकें शायद थोड़ी भारी होने लगी हैं… झपकने में थोड़ी धीमी।",
  "scriptHomeReset06": "कुछ भी सही करने की ज़रूरत नहीं है। जब भी वे तैयार हों… आप अपनी आँखें बंद होने दे सकते हैं।",
  "scriptHomeReset07": "चलिए, साथ मिलकर साँस धीमी करें। लंबी साँस छोड़ना आपके शरीर को बताता है कि आप सुरक्षित हैं।",
  "scriptHomeReset08": "साँस अंदर… दो… तीन… चार। और बाहर… दो… तीन… चार… पाँच… छह।",
  "scriptHomeReset09": "फिर से। अंदर… दो… तीन… चार। और धीरे-धीरे बाहर… कंधों को ढीला छोड़ते हुए… पाँच… छह।",
  "scriptHomeReset10": "अच्छा। अब साँस को अपनी लय खुद ढूँढ़ने दें।",
  "scriptHomeReset11": "थोड़ी देर में मैं दस से एक तक गिनूँगा। हर अंक के साथ आप सुकून में दुगुना गहरे उतर सकते हैं… और आपको कोशिश नहीं करनी। बस सुनिए।",
  "scriptHomeReset12": "दस… छोड़ते हुए।",
  "scriptHomeReset13": "नौ… अब और नरम।",
  "scriptHomeReset14": "आठ… दिन का शोर और दूर होता हुआ।",
  "scriptHomeReset15": "सात…",
  "scriptHomeReset16": "छह… और गहरा, और शांत।",
  "scriptHomeReset17": "पाँच… आधा रास्ता, और आराम से।",
  "scriptHomeReset18": "चार…",
  "scriptHomeReset19": "तीन… हर साँस आपको और नीचे ले जाती हुई।",
  "scriptHomeReset20": "दो… लगभग पहुँच गए।",
  "scriptHomeReset21": "और एक।",
  "scriptHomeReset22": "यहीं आराम करते हुए। शांत। सुरक्षित।",
  "scriptHomeReset23": "अब धीरे-धीरे पूरे शरीर से होकर चलते हैं… और तनाव को नरम होने देते हैं, जहाँ भी वह छिपा हो।",
  "scriptHomeReset24": "कल्पना करें कि गुनगुना पानी धीरे-धीरे आप पर बह रहा है, सिर के ऊपर से लेकर पैरों तक। जहाँ-जहाँ वह बहता है, तनाव पिघल जाता है।",
  "scriptHomeReset25": "देखें कि कहीं कोई जगह अब भी कसी हुई तो नहीं। उसमें साँस भरें… और उसे भी बाकी शरीर के साथ आराम में शामिल होने दें।",
  "scriptHomeReset26": "एक पल लेकर धीरे से देखें कि कहीं कुछ अब भी जकड़ा तो नहीं… सिकुड़ी भौंहें, भिंचा हुआ हाथ, रुकी हुई साँस। जहाँ भी मिले, साँस अंदर लें… और साँस छोड़ते हुए उसे पिघल जाने दें।",
  "scriptHomeReset27": "कूल्हों से नीचे… टाँगें… नीचे ज़मीन पर टिके पैरों तक। ज़मीन से जुड़े। सहारे में। अभी कुछ भी थामे रखने की ज़रूरत नहीं।",
  "scriptHomeReset28": "आपका पूरा शरीर… शांत, भारी और सुरक्षित। कुछ शांत साँसों तक इस एहसास का आनंद लें।",
  "scriptHomeReset29": "कल्पना करें कि आप अपने घर में घूम रहे हैं और एक-एक करके हर खिड़की खोल रहे हैं।",
  "scriptHomeReset30": "समुद्र की ताज़ा हवा हर कमरे से होकर गुज़रती है… हवा को साफ़ करती हुई, शोर और भारीपन को अपने साथ ले जाती हुई। सब कुछ हल्का लगता है। साफ़। शांत।",
  "scriptHomeReset31": "और जब आप यहाँ आराम कर रहे हैं, इन शब्दों को कहीं गहरे उतरने दें, जहाँ वे चुपचाप आपके लिए काम कर सकें:",
  "scriptHomeReset32": "घर बहुत कुछ समेटे रहता है। उसे इस पल के बाहर इंतज़ार करने दें।",
  "scriptHomeReset33": "भरे-पूरे, व्यस्त घर में भी आप एक शांत कोना बना सकते हैं।",
  "scriptHomeReset34": "यहाँ आराम करने की इजाज़त है।",
  "scriptHomeReset35": "अब धीरे से एक लंबी, गहरी आह छोड़ें।",
  "scriptHomeReset36": "एक धीमी साँस लें… और मन ही मन खुद से कहें: मैं अपने भीतर घर पर हूँ।",
  "scriptHomeReset37": "महसूस करें कि यह सुकून यहीं इकट्ठा हो रहा है। अब से, जब घर में अफ़रा-तफ़री लगे, या आपको अपने लिए एक पल चाहिए हो, आप फिर से ऐसा कर सकते हैं… एक साँस लें… और यही सुकून लौट आएगा, हर बार थोड़ा और मज़बूत।",
  "scriptHomeReset38": "अब इसे छोड़ दें।",
  "scriptHomeReset39": "अब यहीं आराम करें… कुछ करना नहीं, कहीं जाना नहीं… बस सुकून को भीतर बैठने दें, हर साँस के साथ और गहरा।",
  "scriptHomeReset40": "लौटने से पहले… घर का एक छोटा-सा कोना चुनें जिसे आप आज शांत बना सकते हैं।",
  "scriptHomeReset41": "खुद को उसे शांति से करते हुए देखें।",
  "scriptHomeReset42": "अब मैं एक से पाँच तक गिनूँगा। हर अंक के साथ आप ज़्यादा जागे हुए, ज़्यादा सजग महसूस करेंगे… सुकून को साथ लेकर।",
  "scriptHomeReset43": "एक… अपने नीचे के सहारे को महसूस करते हुए।",
  "scriptHomeReset44": "दो… कमरे की आवाज़ें लौटती हुईं।",
  "scriptHomeReset45": "तीन… एक गहरी साँस, हाथों और पैरों की उंगलियाँ हिलाते हुए।",
  "scriptHomeReset46": "चार… ऊर्जा लौटती हुई, साफ़ और केंद्रित।",
  "scriptHomeReset47": "और पाँच… जब तैयार हों तो आँखें खोलें… शांत, साफ़ और तैयार।",
  "scriptHomeReset48": "बहुत बढ़िया। याद रखें: मैं अपने भीतर घर पर हूँ। मैं यहाँ आपके साथ हूँ।",
  "meditateManagerTitle": "मैनेजर के सामने आत्मविश्वास",
  "afterAnchorManager": "सीधे बैठें, ठोड़ी सीधी · “पाँव ज़मीन पर, मन साफ़।”",
  "scriptManager01": "नमस्ते। मैं यहाँ आपके साथ हूँ।",
  "scriptManager02": "मैनेजर के साथ मीटिंग में हम खुद को छोटा महसूस कर सकते हैं, तब भी जब हम अच्छा काम कर रहे हों। इन दस मिनटों के लिए, आप फिर से अपने भीतर सिर ऊँचा करके खड़े हो सकते हैं।",
  "scriptManager03": "ऐसी स्थिति ढूँढ़ें जिसमें आपके शरीर को सहारा मिले। पैर ज़मीन पर सपाट। हाथ जहाँ टिकना चाहें, वहीं टिके रहें।",
  "scriptManager04": "अब अपनी आँखों को सामने कोई एक छोटा-सा बिंदु ढूँढ़ने दें… और बस अपनी नज़र वहीं टिका दें।",
  "scriptManager05": "उसे देखते रहें… और ध्यान दें कि आपकी पलकें शायद थोड़ी भारी होने लगी हैं… झपकने में थोड़ी धीमी।",
  "scriptManager06": "कुछ भी सही करने की ज़रूरत नहीं है। जब भी वे तैयार हों… आप अपनी आँखें बंद होने दे सकते हैं।",
  "scriptManager07": "चलिए, साथ मिलकर साँस धीमी करें। लंबी साँस छोड़ना आपके शरीर को बताता है कि आप सुरक्षित हैं।",
  "scriptManager08": "साँस अंदर… दो… तीन… चार। और बाहर… दो… तीन… चार… पाँच… छह।",
