  "scriptChores02": "आप कितना कुछ उठाए रहते हैं… सूचियाँ, याद रखने वाली बातें, वे चीज़ें जिन पर बस आपकी ही नज़र जाती है। इन दस मिनटों के लिए, आप यह सब नीचे रख सकते हैं।",
  "scriptChores03": "ऐसी स्थिति ढूँढ़ें जिसमें आपके शरीर को सहारा मिले। पैर ज़मीन पर सपाट। हाथ जहाँ टिकना चाहें, वहीं टिके रहें।",
  "scriptChores04": "अब अपनी आँखों को सामने कोई एक छोटा-सा बिंदु ढूँढ़ने दें… और बस अपनी नज़र वहीं टिका दें।",
  "scriptChores05": "उसे देखते रहें… और ध्यान दें कि आपकी पलकें शायद थोड़ी भारी होने लगी हैं… झपकने में थोड़ी धीमी।",
  "scriptChores06": "कुछ भी सही करने की ज़रूरत नहीं है। जब भी वे तैयार हों… आप अपनी आँखें बंद होने दे सकते हैं।",
  "scriptChores07": "चलिए, साथ मिलकर साँस धीमी करें। लंबी साँस छोड़ना आपके शरीर को बताता है कि आप सुरक्षित हैं।",
  "scriptChores08": "साँस अंदर… दो… तीन… चार। और बाहर… दो… तीन… चार… पाँच… छह।",
  "scriptChores09": "फिर से। अंदर… दो… तीन… चार। और धीरे-धीरे बाहर… कंधों को ढीला छोड़ते हुए… पाँच… छह।",
  "scriptChores10": "अच्छा। अब साँस को अपनी लय खुद ढूँढ़ने दें।",
  "scriptChores11": "थोड़ी देर में मैं दस से एक तक गिनूँगा। हर अंक के साथ आप सुकून में दुगुना गहरे उतर सकते हैं… और आपको कोशिश नहीं करनी। बस सुनिए।",
  "scriptChores12": "दस… छोड़ते हुए।",
  "scriptChores13": "नौ… अब और नरम।",
  "scriptChores14": "आठ… दिन का शोर और दूर होता हुआ।",
  "scriptChores15": "सात…",
  "scriptChores16": "छह… और गहरा, और शांत।",
  "scriptChores17": "पाँच… आधा रास्ता, और आराम से।",
  "scriptChores18": "चार…",
  "scriptChores19": "तीन… हर साँस आपको और नीचे ले जाती हुई।",
  "scriptChores20": "दो… लगभग पहुँच गए।",
  "scriptChores21": "और एक।",
  "scriptChores22": "यहीं आराम करते हुए। शांत। सुरक्षित।",
  "scriptChores23": "अब धीरे-धीरे पूरे शरीर से होकर चलते हैं… और तनाव को नरम होने देते हैं, जहाँ भी वह छिपा हो।",
  "scriptChores24": "आपके कंधे और पीठ का ऊपरी हिस्सा। कल्पना करें कि आपका हर काम वहाँ रखा एक बोझ है। अब, साँस-दर-साँस, उन्हें हल्का होते महसूस करें।",
  "scriptChores25": "बाँहों को आराम करने दें। उंगलियाँ खुल जाएँ। आपके हाथ में न कोई फ़ोन है, न सूची, न कपड़ा, न थैला। बस हवा।",
  "scriptChores26": "एक पल लेकर धीरे से देखें कि कहीं कुछ अब भी जकड़ा तो नहीं… सिकुड़ी भौंहें, भिंचा हुआ हाथ, रुकी हुई साँस। जहाँ भी मिले, साँस अंदर लें… और साँस छोड़ते हुए उसे पिघल जाने दें।",
  "scriptChores27": "कूल्हों से नीचे… टाँगें… नीचे ज़मीन पर टिके पैरों तक। ज़मीन से जुड़े। सहारे में। अभी कुछ भी थामे रखने की ज़रूरत नहीं।",
  "scriptChores28": "आपका पूरा शरीर… शांत, भारी और सुरक्षित। कुछ शांत साँसों तक इस एहसास का आनंद लें।",
  "scriptChores29": "कल्पना करें कि आप गर्म रेत पर चल रहे हैं, दोनों हाथों में भारी थैले लिए।",
  "scriptChores30": "एक-एक करके आप उन्हें नीचे रख देते हैं। कपड़े धोना। बर्तन। अपॉइंटमेंट। वे बातें जिन्हें आप याद रखने की कोशिश कर रहे हैं।",
  "scriptChores31": "हर थैला नीचे रखने के साथ आपके कदम हल्के होते जाते हैं। थैले इंतज़ार करेंगे। वे हमेशा करते हैं। अभी… आप बस चलते हैं।",
  "scriptChores32": "और जब आप यहाँ आराम कर रहे हैं, इन शब्दों को कहीं गहरे उतरने दें, जहाँ वे चुपचाप आपके लिए काम कर सकें:",
  "scriptChores33": "सूची इंतज़ार कर सकती है। पहले आराम करने की आपको इजाज़त है।",
  "scriptChores34": "मदद माँगना बाँटना है, हारना नहीं।",
  "scriptChores35": "पूरा हो जाना, परफ़ेक्ट होने से बेहतर है।",
  "scriptChores36": "अब धीरे से अपने कंधों को आराम से पीछे की ओर घुमाएँ।",
  "scriptChores37": "एक धीमी साँस लें… और मन ही मन खुद से कहें: एक काम, फिर आराम।",
  "scriptChores38": "महसूस करें कि यह सुकून यहीं इकट्ठा हो रहा है। अब से, जब सूची कभी ख़त्म न होती लगे, या आप खुद को एक काम से दूसरे काम की ओर भागते पाएँ, आप फिर से ऐसा कर सकते हैं… एक साँस लें… और यही सुकून लौट आएगा, हर बार थोड़ा और मज़बूत।",
  "scriptChores39": "अब इसे छोड़ दें।",
  "scriptChores40": "अब यहीं आराम करें… कुछ करना नहीं, कहीं जाना नहीं… बस सुकून को भीतर बैठने दें, हर साँस के साथ और गहरा।",
  "scriptChores41": "लौटने से पहले… एक काम चुनें जिसे आप आज छोड़ देंगे, या जिसमें मदद माँगेंगे।",
  "scriptChores42": "खुद को उसे शांति से करते हुए देखें।",
  "scriptChores43": "अब मैं एक से पाँच तक गिनूँगा। हर अंक के साथ आप ज़्यादा जागे हुए, ज़्यादा सजग महसूस करेंगे… सुकून को साथ लेकर।",
  "scriptChores44": "एक… अपने नीचे के सहारे को महसूस करते हुए।",
  "scriptChores45": "दो… कमरे की आवाज़ें लौटती हुईं।",
  "scriptChores46": "तीन… एक गहरी साँस, हाथों और पैरों की उंगलियाँ हिलाते हुए।",
  "scriptChores47": "चार… ऊर्जा लौटती हुई, साफ़ और केंद्रित।",
  "scriptChores48": "और पाँच… जब तैयार हों तो आँखें खोलें… शांत, साफ़ और तैयार।",
  "scriptChores49": "बहुत बढ़िया। याद रखें: एक काम, फिर आराम। मैं यहाँ आपके साथ हूँ।",
