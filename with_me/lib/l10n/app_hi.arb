  "scriptTeachers03": "ऐसी स्थिति ढूँढ़ें जिसमें आपके शरीर को सहारा मिले। पैर ज़मीन पर सपाट। हाथ जहाँ टिकना चाहें, वहीं टिके रहें।",
  "scriptTeachers04": "अब अपनी आँखों को सामने कोई एक छोटा-सा बिंदु ढूँढ़ने दें… और बस अपनी नज़र वहीं टिका दें।",
  "scriptTeachers05": "उसे देखते रहें… और ध्यान दें कि आपकी पलकें शायद थोड़ी भारी होने लगी हैं… झपकने में थोड़ी धीमी।",
  "scriptTeachers06": "कुछ भी सही करने की ज़रूरत नहीं है। जब भी वे तैयार हों… आप अपनी आँखें बंद होने दे सकते हैं।",
  "scriptTeachers07": "चलिए, साथ मिलकर साँस धीमी करें। लंबी साँस छोड़ना आपके शरीर को बताता है कि आप सुरक्षित हैं।",
  "scriptTeachers08": "साँस अंदर… दो… तीन… चार। और बाहर… दो… तीन… चार… पाँच… छह।",
  "scriptTeachers09": "फिर से। अंदर… दो… तीन… चार। और धीरे-धीरे बाहर… कंधों को ढीला छोड़ते हुए… पाँच… छह।",
  "scriptTeachers10": "अच्छा। अब साँस को अपनी लय खुद ढूँढ़ने दें।",
  "scriptTeachers11": "थोड़ी देर में मैं दस से एक तक गिनूँगा। हर अंक के साथ आप सुकून में दुगुना गहरे उतर सकते हैं… और आपको कोशिश नहीं करनी। बस सुनिए।",
  "scriptTeachers12": "दस… छोड़ते हुए।",
  "scriptTeachers13": "नौ… अब और नरम।",
  "scriptTeachers14": "आठ… दिन का शोर और दूर होता हुआ।",
  "scriptTeachers15": "सात…",
  "scriptTeachers16": "छह… और गहरा, और शांत।",
  "scriptTeachers17": "पाँच… आधा रास्ता, और आराम से।",
  "scriptTeachers18": "चार…",
  "scriptTeachers19": "तीन… हर साँस आपको और नीचे ले जाती हुई।",
  "scriptTeachers20": "दो… लगभग पहुँच गए।",
  "scriptTeachers21": "और एक।",
  "scriptTeachers22": "यहीं आराम करते हुए। शांत। सुरक्षित।",
  "scriptTeachers23": "अब धीरे-धीरे पूरे शरीर से होकर चलते हैं… और तनाव को नरम होने देते हैं, जहाँ भी वह छिपा हो।",
  "scriptTeachers24": "अपना ध्यान गले पर लाएँ। उसे ढीला होने और खुलने दें। धीरे से थूक निगलें।",
  "scriptTeachers25": "अब जबड़ा और जीभ। जीभ को मुँह में नरमी से टिकने दें। जबड़े को ढीला लटकने दें।",
  "scriptTeachers26": "एक पल लेकर धीरे से देखें कि कहीं कुछ अब भी जकड़ा तो नहीं… सिकुड़ी भौंहें, भिंचा हुआ हाथ, रुकी हुई साँस। जहाँ भी मिले, साँस अंदर लें… और साँस छोड़ते हुए उसे पिघल जाने दें।",
  "scriptTeachers27": "कूल्हों से नीचे… टाँगें… नीचे ज़मीन पर टिके पैरों तक। ज़मीन से जुड़े। सहारे में। अभी कुछ भी थामे रखने की ज़रूरत नहीं।",
  "scriptTeachers28": "आपका पूरा शरीर… शांत, भारी और सुरक्षित। कुछ शांत साँसों तक इस एहसास का आनंद लें।",
  "scriptTeachers29": "अपनी आवाज़ को किनारे की ओर बढ़ती एक शांत लहर की तरह सोचें।",
  "scriptTeachers30": "उसे ज़ोरदार होने की ज़रूरत नहीं। वह बस पहुँचती है, साफ़ और स्थिर, और रेत तक आ जाती है। तट पर हर कोई उसे सुन सकता है।",
  "scriptTeachers31": "और जब आप यहाँ आराम कर रहे हैं, इन शब्दों को कहीं गहरे उतरने दें, जहाँ वे चुपचाप आपके लिए काम कर सकें:",
  "scriptTeachers32": "आपके सवाल जगह के हक़दार हैं। पूछना एक ताक़त है।",
  "scriptTeachers33": "घबराहट होने पर भी आप शांति से बोल सकते हैं।",
  "scriptTeachers34": "ग़लतियों से ही हर कोई सीखता है।",
  "scriptTeachers35": "अब धीरे से जीभ को ढीला छोड़ें और आराम से थूक निगलें।",
  "scriptTeachers36": "एक धीमी साँस लें… और मन ही मन खुद से कहें: मेरी आवाज़ मायने रखती है।",
  "scriptTeachers37": "महसूस करें कि यह सुकून यहीं इकट्ठा हो रहा है। अब से, क्लास में सवाल पूछने से पहले, या किसी टीचर से बात करने से पहले, आप फिर से ऐसा कर सकते हैं… एक साँस लें… और यही सुकून लौट आएगा, हर बार थोड़ा और मज़बूत।",
  "scriptTeachers38": "अब इसे छोड़ दें।",
  "scriptTeachers39": "अब यहीं आराम करें… कुछ करना नहीं, कहीं जाना नहीं… बस सुकून को भीतर बैठने दें, हर साँस के साथ और गहरा।",
  "scriptTeachers40": "लौटने से पहले… इस हफ़्ते के लिए एक सवाल चुनें जो आप पूछेंगे, या एक बात जो आप कहेंगे।",
  "scriptTeachers41": "खुद को उसे शांति से करते हुए देखें।",
  "scriptTeachers42": "अब मैं एक से पाँच तक गिनूँगा। हर अंक के साथ आप ज़्यादा जागे हुए, ज़्यादा सजग महसूस करेंगे… सुकून को साथ लेकर।",
  "scriptTeachers43": "एक… अपने नीचे के सहारे को महसूस करते हुए।",
  "scriptTeachers44": "दो… कमरे की आवाज़ें लौटती हुईं।",
  "scriptTeachers45": "तीन… एक गहरी साँस, हाथों और पैरों की उंगलियाँ हिलाते हुए।",
  "scriptTeachers46": "चार… ऊर्जा लौटती हुई, साफ़ और केंद्रित।",
  "scriptTeachers47": "और पाँच… जब तैयार हों तो आँखें खोलें… शांत, साफ़ और तैयार।",
  "scriptTeachers48": "बहुत बढ़िया। याद रखें: मेरी आवाज़ मायने रखती है। मैं यहाँ आपके साथ हूँ।",
  "meditateClassmatesTitle": "अपनापन",
