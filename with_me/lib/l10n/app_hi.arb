  "scriptChildren05": "उसे देखते रहें… और ध्यान दें कि आपकी पलकें शायद थोड़ी भारी होने लगी हैं… झपकने में थोड़ी धीमी।",
  "scriptChildren06": "कुछ भी सही करने की ज़रूरत नहीं है। जब भी वे तैयार हों… आप अपनी आँखें बंद होने दे सकते हैं।",
  "scriptChildren07": "चलिए, साथ मिलकर साँस धीमी करें। लंबी साँस छोड़ना आपके शरीर को बताता है कि आप सुरक्षित हैं।",
  "scriptChildren08": "साँस अंदर… दो… तीन… चार। और बाहर… दो… तीन… चार… पाँच… छह।",
  "scriptChildren09": "फिर से। अंदर… दो… तीन… चार। और धीरे-धीरे बाहर… कंधों को ढीला छोड़ते हुए… पाँच… छह।",
  "scriptChildren10": "अच्छा। अब साँस को अपनी लय खुद ढूँढ़ने दें।",
  "scriptChildren11": "थोड़ी देर में मैं दस से एक तक गिनूँगा। हर अंक के साथ आप सुकून में दुगुना गहरे उतर सकते हैं… और आपको कोशिश नहीं करनी। बस सुनिए।",
  "scriptChildren12": "दस… छोड़ते हुए।",
  "scriptChildren13": "नौ… अब और नरम।",
  "scriptChildren14": "आठ… दिन का शोर और दूर होता हुआ।",
  "scriptChildren15": "सात…",
  "scriptChildren16": "छह… और गहरा, और शांत।",
  "scriptChildren17": "पाँच… आधा रास्ता, और आराम से।",
  "scriptChildren18": "चार…",
  "scriptChildren19": "तीन… हर साँस आपको और नीचे ले जाती हुई।",
  "scriptChildren20": "दो… लगभग पहुँच गए।",
  "scriptChildren21": "और एक।",
  "scriptChildren22": "यहीं आराम करते हुए। शांत। सुरक्षित।",
  "scriptChildren23": "अब धीरे-धीरे पूरे शरीर से होकर चलते हैं… और तनाव को नरम होने देते हैं, जहाँ भी वह छिपा हो।",
  "scriptChildren24": "कंधों से शुरू करें। वे नन्हे बच्चों को, थैलों को, चिंताओं को उठाते हैं। अब उन्हें नीचे गिरने दें… भारी और गर्म।",
  "scriptChildren25": "आपका जबड़ा… दाँतों को थोड़ा अलग होने दें। आपके हाथ… उन्हें खोलें, हथेलियाँ ऊपर, जैसे सब कुछ नीचे रख रहे हों। अभी कुछ भी थामे रखने की ज़रूरत नहीं।",
  "scriptChildren26": "एक पल लेकर धीरे से देखें कि कहीं कुछ अब भी जकड़ा तो नहीं… सिकुड़ी भौंहें, भिंचा हुआ हाथ, रुकी हुई साँस। जहाँ भी मिले, साँस अंदर लें… और साँस छोड़ते हुए उसे पिघल जाने दें।",
  "scriptChildren27": "कूल्हों से नीचे… टाँगें… नीचे ज़मीन पर टिके पैरों तक। ज़मीन से जुड़े। सहारे में। अभी कुछ भी थामे रखने की ज़रूरत नहीं।",
  "scriptChildren28": "आपका पूरा शरीर… शांत, भारी और सुरक्षित। कुछ शांत साँसों तक इस एहसास का आनंद लें।",
  "scriptChildren29": "कल्पना करें कि चट्टानों वाले किनारे पर एक लाइटहाउस खड़ा है। उसके चारों ओर लहरें उछलती हैं, खेलती हैं, टकराती हैं और खिलखिलाती हैं।",
  "scriptChildren30": "लाइटहाउस लहरों के पीछे नहीं भागता, न उन पर चिल्लाता है। वह बस खड़ा रहता है, स्थिर और गर्म, उसकी रोशनी धीरे-धीरे घूमती रहती है। यही स्थिरता हर नाव को सुरक्षित रखती है।",
  "scriptChildren31": "और जब आप यहाँ आराम कर रहे हैं, इन शब्दों को कहीं गहरे उतरने दें, जहाँ वे चुपचाप आपके लिए काम कर सकें:",
  "scriptChildren32": "अच्छे माता-पिता बनने के लिए परफ़ेक्ट होना ज़रूरी नहीं।",
  "scriptChildren33": "आपका सुकून आपके शब्दों से ज़्यादा सिखाता है।",
  "scriptChildren34": "जवाब देने से पहले रुकना ठीक है।",
  "scriptChildren35": "अब धीरे से तीन धीमी साँसें लें।",
  "scriptChildren36": "एक धीमी साँस लें… और मन ही मन खुद से कहें: लाइटहाउस की तरह स्थिर।",
  "scriptChildren37": "महसूस करें कि यह सुकून यहीं इकट्ठा हो रहा है। अब से, जब शोर बढ़े, जब आँसू शुरू हों, या जब लगे कि सब्र छूट रहा है, आप फिर से ऐसा कर सकते हैं… एक साँस लें… और यही सुकून लौट आएगा, हर बार थोड़ा और मज़बूत।",
  "scriptChildren38": "अब इसे छोड़ दें।",
  "scriptChildren39": "अब यहीं आराम करें… कुछ करना नहीं, कहीं जाना नहीं… बस सुकून को भीतर बैठने दें, हर साँस के साथ और गहरा।",
  "scriptChildren40": "लौटने से पहले… आज एक छोटा-सा पल चुनें जब आप बिना जल्दबाज़ी के बस अपने बच्चे के साथ रहें।",
  "scriptChildren41": "खुद को उसे शांति से करते हुए देखें।",
  "scriptChildren42": "अब मैं एक से पाँच तक गिनूँगा। हर अंक के साथ आप ज़्यादा जागे हुए, ज़्यादा सजग महसूस करेंगे… सुकून को साथ लेकर।",
  "scriptChildren43": "एक… अपने नीचे के सहारे को महसूस करते हुए।",
  "scriptChildren44": "दो… कमरे की आवाज़ें लौटती हुईं।",
  "scriptChildren45": "तीन… एक गहरी साँस, हाथों और पैरों की उंगलियाँ हिलाते हुए।",
  "scriptChildren46": "चार… ऊर्जा लौटती हुई, साफ़ और केंद्रित।",
  "scriptChildren47": "और पाँच… जब तैयार हों तो आँखें खोलें… शांत, साफ़ और तैयार।",
  "scriptChildren48": "बहुत बढ़िया। याद रखें: लाइटहाउस की तरह स्थिर। मैं यहाँ आपके साथ हूँ।",
  "meditateFamilyTitle": "परिवार के साथ सुकून",
