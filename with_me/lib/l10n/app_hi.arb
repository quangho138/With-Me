  "scriptDeadline01": "नमस्ते। मैं यहाँ आपके साथ हूँ।",
  "scriptDeadline02": "अगले दस मिनट के लिए डेडलाइन दरवाज़े के बाहर इंतज़ार कर सकती है। जब आप लौटेंगे, वह वहीं होगी, और आप उसका सामना ज़्यादा साफ़ मन से करेंगे।",
  "scriptDeadline03": "ऐसी स्थिति ढूँढ़ें जिसमें आपके शरीर को सहारा मिले। पैर ज़मीन पर सपाट। हाथ जहाँ टिकना चाहें, वहीं टिके रहें।",
  "scriptDeadline04": "अब अपनी आँखों को सामने कोई एक छोटा-सा बिंदु ढूँढ़ने दें… दीवार पर कोई निशान, मेज़ का किनारा… और बस अपनी नज़र वहीं टिका दें।",
  "scriptDeadline05": "उसे देखते रहें… और ध्यान दें कि आपकी पलकें शायद थोड़ी भारी होने लगी हैं… झपकने में थोड़ी धीमी।",
  "scriptDeadline06": "कुछ भी सही करने की ज़रूरत नहीं है। जब भी वे तैयार हों… आप अपनी आँखें बंद होने दे सकते हैं।",
  "scriptDeadline07": "चलिए, साथ मिलकर साँस धीमी करें। लंबी साँस छोड़ना आपके शरीर को बताता है कि आप सुरक्षित हैं।",
  "scriptDeadline08": "साँस अंदर… दो… तीन… चार। और बाहर… दो… तीन… चार… पाँच… छह।",
  "scriptDeadline09": "फिर से। अंदर… दो… तीन… चार। और धीरे-धीरे बाहर… कंधों को ढीला छोड़ते हुए… पाँच… छह।",
  "scriptDeadline10": "अच्छा। अब साँस को अपनी लय खुद ढूँढ़ने दें।",
  "scriptDeadline11": "थोड़ी देर में मैं दस से एक तक गिनूँगा। हर अंक के साथ आप सुकून में दुगुना गहरे उतर सकते हैं… और आपको कोशिश नहीं करनी। बस सुनिए।",
  "scriptDeadline12": "दस… छोड़ते हुए।",
  "scriptDeadline13": "नौ… अब और नरम।",
  "scriptDeadline14": "आठ… दिन का शोर और दूर होता हुआ।",
  "scriptDeadline15": "सात…",
  "scriptDeadline16": "छह… और गहरा, और शांत।",
  "scriptDeadline17": "पाँच… आधा रास्ता, और आराम से।",
  "scriptDeadline18": "चार…",
  "scriptDeadline19": "तीन… हर साँस आपको और नीचे ले जाती हुई।",
  "scriptDeadline20": "दो… लगभग पहुँच गए।",
  "scriptDeadline21": "और एक।",
  "scriptDeadline22": "यहीं आराम करते हुए। शांत। सुरक्षित।",
  "scriptDeadline23": "काम का दबाव अक्सर कुछ गिनी-चुनी जगहों पर छिपा रहता है। चलिए, हर एक तक चलते हैं… और उसे नरम होने देते हैं।",
  "scriptDeadline24": "माथे से शुरू करें। वह जगह जो स्क्रीन और ईमेल देखकर सिकुड़ जाती है। कल्पना करें कि एक गर्म हथेली वहाँ टिकी है… उसे सहलाकर सीधा करती हुई…",
  "scriptDeadline25": "अब जबड़ा। दाँतों को थोड़ा अलग होने दें। जीभ को आराम करने दें। दिन का बहुत कुछ जबड़े में अटका रहता है… और अब आप उसे छोड़ सकते हैं।",
  "scriptDeadline26": "गर्दन और कंधे। सोचिए कि वे पूरे दिन कानों की ओर उठे रहे हैं… और अब, अगली साँस छोड़ते हुए… वे नीचे गिर जाते हैं। भारी। गर्म।",
  "scriptDeadline27": "बाँहों से नीचे की ओर… कलाइयाँ, टाइप करते-करते थकी हुई… हाथ। उंगलियों को ढीला और स्थिर होने दें।",
  "scriptDeadline28": "अब सीना और पेट। देखें कि वहाँ कोई जकड़न तो नहीं, जल्दबाज़ी की कोई गाँठ। उससे लड़ने की ज़रूरत नहीं।",
  "scriptDeadline29": "बस उसमें साँस भरें… और साँस छोड़ते हुए कल्पना करें कि वह ढीली हो रही है… एक-एक धागा।",
  "scriptDeadline30": "कमर का निचला हिस्सा… कूल्हे… टाँगें… नीचे ज़मीन पर टिके पैरों तक। ज़मीन से जुड़े। सहारे में। अभी कुछ भी थामे रखने की ज़रूरत नहीं।",
  "scriptDeadline31": "आपका पूरा शरीर, शांत, भारी और सुरक्षित।",
  "scriptDeadline32": "अब कल्पना करें कि आप एक शांत समुद्र तट पर खड़े हैं, बिलकुल ऐप वाले जैसा। पैरों के नीचे गर्म रेत। समुद्र आता… और जाता… अपने ही समय में।",
  "scriptDeadline33": "ध्यान दें, लहरें कभी जल्दी नहीं करतीं। हर लहर आती है… अपना काम करती है… और अगली के लिए जगह बना देती है।",
  "scriptDeadline34": "आपका काम भी ऐसा हो सकता है। एक लहर। एक काम। फिर अगला।",
  "scriptDeadline35": "और जब आप यहाँ आराम कर रहे हैं, इन शब्दों को कहीं गहरे उतरने दें, जहाँ वे चुपचाप आपके लिए काम कर सकें:",
  "scriptDeadline36": "आपकी कीमत आपके काम के बोझ से नहीं है।",
  "scriptDeadline37": "आप पहले भी डेडलाइन पूरी कर चुके हैं, और यह भी कर सकते हैं।",
  "scriptDeadline38": "शांत मन घबराए मन से तेज़ काम करता है।",
  "scriptDeadline39": "एक काम अच्छे से करना काफ़ी है।",
  "scriptDeadline40": "अब धीरे से अपने अंगूठे का सिरा तर्जनी उंगली के सिरे से मिलाएँ।",
  "scriptDeadline41": "एक धीमी साँस लें… और मन ही मन खुद से कहें: एक समय में एक काम।",
  "scriptDeadline42": "महसूस करें कि यह सुकून आपकी उंगलियों के सिरों पर इकट्ठा हो रहा है। अब से, जब भी काम पर दबाव बढ़े… किसी मीटिंग में, भेजें दबाने से पहले, जब घड़ी ज़ोर से चलती लगे…",
  "scriptDeadline43": "आप अंगूठा और उंगली मिला सकते हैं, एक साँस ले सकते हैं, और यही सुकून लौट आएगा, हर बार थोड़ा और मज़बूत।",
  "scriptDeadline44": "अब उंगलियाँ छोड़ दें।",
  "scriptDeadline45": "लौटने से पहले, एक छोटा-सा काम चुनें जो आप अगले एक घंटे में करेंगे। बस एक। पहला कदम, पूरा पहाड़ नहीं।",
  "scriptDeadline46": "खुद को उसे शांति से करते हुए देखें।",
  "scriptDeadline47": "अब मैं एक से पाँच तक गिनूँगा। हर अंक के साथ आप ज़्यादा जागे हुए, ज़्यादा सजग महसूस करेंगे… सुकून को साथ लेकर।",
  "scriptDeadline48": "एक… नीचे की कुर्सी को महसूस करते हुए।",
  "scriptDeadline49": "दो… कमरे की आवाज़ें लौटती हुईं।",
  "scriptDeadline50": "तीन… एक गहरी साँस, हाथों और पैरों की उंगलियाँ हिलाते हुए।",
  "scriptDeadline51": "चार… ऊर्जा लौटती हुई, साफ़ और केंद्रित।",
  "scriptDeadline52": "और पाँच… जब तैयार हों तो आँखें खोलें, शांत, साफ़ और तैयार।",
  "scriptDeadline53": "बहुत बढ़िया। याद रखें: एक समय में एक काम। मैं यहाँ आपके साथ हूँ।",
  "scriptSos01": "मैं यहाँ आपके साथ हूँ। अभी आपको कुछ भी ठीक करने की ज़रूरत नहीं है।",
  "scriptSos02": "एक हाथ सीने पर रखें। धीरे से चार तक साँस अंदर लें… और छह तक बाहर छोड़ें।",
  "scriptSos03": "अब ज़मीन पर अपने पैरों को महसूस करें। उन्हें धीरे से नीचे दबाएँ। आप यहाँ हैं, और आप सुरक्षित हैं।",
  "scriptSos04": "एक और धीमी साँस। अंदर… और बाहर। बहुत बढ़िया।",
  "scriptBodyScan01": "नमस्ते। मैं यहाँ आपके साथ हूँ। चलिए, कुछ मिनट अपने शरीर को महसूस करते हैं, एक-एक हिस्सा।",
  "scriptBodyScan02": "किसी आरामदायक जगह बैठ जाएँ या लेट जाएँ। आँखें बंद कर लें, या नज़र ज़मीन पर टिका दें।",
  "scriptBodyScan03": "धीरे से साँस अंदर लें… और लंबी साँस बाहर छोड़ें।",
  "scriptBodyScan04": "अपना ध्यान सिर के ऊपरी हिस्से पर ले जाएँ। बस महसूस करें कि वहाँ क्या है: गर्माहट, झनझनाहट, या कुछ भी नहीं।",
  "scriptBodyScan05": "नीचे माथे और आँखों तक आएँ। अगर कोई जकड़न हो, तो साँस छोड़ते हुए उसे नरम होने दें।",
  "scriptBodyScan06": "अब जबड़ा। दाँतों को थोड़ा अलग होने दें और जीभ को आराम करने दें।",
  "scriptBodyScan07": "गर्दन और कंधों को महसूस करें। उन्हें भारी होने दें और कानों से दूर नीचे जाने दें।",
  "scriptBodyScan08": "बाँहें, कोहनियाँ, कलाइयाँ और हाथ महसूस करें। उंगलियों को आराम करने दें, ढीली और स्थिर।",
  "scriptBodyScan09": "अपना ध्यान सीने पर ले जाएँ। हर साँस के साथ उसे उठते और गिरते महसूस करें, कुछ भी बदले बिना।",
  "scriptBodyScan10": "पेट पर ध्यान दें। अगर वह कसा हुआ लगे, तो धीरे से उसमें साँस भरें, और उसे नरम होने दें।",
  "scriptBodyScan11": "कमर के निचले हिस्से और कूल्हों पर आएँ। उन्हें उस चीज़ में धँसने दें जो आपको सहारा दे रही है।",
  "scriptBodyScan12": "टाँगें, घुटने, और नीचे पैरों तक महसूस करें। देखें कि वे ज़मीन को कहाँ छूते हैं।",
  "scriptBodyScan13": "अब पूरे शरीर को एक साथ महसूस करें, सिर से पैर तक, शांति से साँस लेते हुए।",
  "scriptBodyScan14": "आपने जो भी महसूस किया, वह ठीक है। जब तैयार हों, हाथों और पैरों की उंगलियाँ हिलाएँ, और आँखें खोलें।",
  "scriptMuscle01": "नमस्ते। मैं यहाँ आपके साथ हूँ। हम हर मांसपेशी समूह को कुछ सेकंड के लिए कसेंगे, फिर छोड़ देंगे। कभी इतना मत कसें कि दर्द हो।",
  "scriptMuscle02": "आराम से बैठें और धीरे से साँस अंदर लें… और बाहर छोड़ें।",
  "scriptMuscle03": "दोनों हाथों की कसकर मुट्ठी बनाएँ। दबाएँ… और रोकें।",
  "scriptMuscle04": "और छोड़ दें। हाथों को खुलने दें। महसूस करें कि वे कितने अलग लग रहे हैं।",
  "scriptMuscle05": "अब बाँहें मोड़ें और ऊपरी बाँहों की मांसपेशियाँ कसें। रोकें।",
  "scriptMuscle06": "और छोड़ दें। बाँहों को आराम करने दें, भारी और गर्म।",
  "scriptMuscle07": "कंधों को कानों की ओर ऊपर उठाएँ। उन्हें वहीं रोकें।",
  "scriptMuscle08": "और नीचे गिरा दें। तनाव को फिसलकर दूर जाते महसूस करें।",
  "scriptMuscle09": "चेहरे को सिकोड़ें: आँखें कसकर बंद करें और होंठ आपस में दबाएँ। रोकें।",
  "scriptMuscle10": "और छोड़ दें। माथे, आँखों और जबड़े को नरम होने दें।",
  "scriptMuscle11": "गहरी साँस लें और रोकें, सीने और पेट को कसते हुए।",
  "scriptMuscle12": "और धीरे-धीरे साँस छोड़ें, सब कुछ ढीला होने दें।",
  "scriptMuscle13": "घुटनों को आपस में दबाएँ और टाँगों को कसें। रोकें।",
  "scriptMuscle14": "और ढीला छोड़ें। टाँगों को भारी होने दें।",
  "scriptMuscle15": "पैर की उंगलियों को नीचे मोड़ें और पैरों को कसें। रोकें।",
  "scriptMuscle16": "और छोड़ दें। पैरों को पूरी तरह ढीला होते महसूस करें।",
  "scriptMuscle17": "अब पूरे शरीर को आराम करने दें। महसूस करें कि यह कितना शांत और भारी लग रहा है।",
  "scriptMuscle18": "जब तैयार हों, एक गहरी साँस लें, थोड़ा अंगड़ाई लें, और आँखें खोलें।",
  "scriptHomeFull01": "नमस्ते। मैं यहाँ आपके साथ हूँ।",
  "scriptHomeFull02": "अगले दस मिनट के लिए घर की हर बात इंतज़ार कर सकती है। काम, संदेश, वे लोग जिन्हें आपकी ज़रूरत है। जब आप लौटेंगे, वे वहीं होंगे, और आप उनसे ज़्यादा नरमी से मिलेंगे।",
  "scriptHomeFull03": "ऐसी स्थिति ढूँढ़ें जिसमें आपके शरीर को सहारा मिले। पीछे टिककर बैठें, या लेट जाएँ। हाथ जहाँ टिकना चाहें, वहीं टिके रहने दें।",
  "scriptHomeFull04": "अब अपनी आँखों को सामने कोई एक छोटा-सा बिंदु ढूँढ़ने दें… कमरे का कोई कोना, हल्की रोशनी का कोई टुकड़ा… और बस अपनी नज़र वहीं टिका दें।",
  "scriptHomeFull05": "उसे देखते रहें… और ध्यान दें कि आपकी पलकें शायद थोड़ी भारी होने लगी हैं… झपकने में थोड़ी धीमी।",
  "scriptHomeFull06": "अभी कुछ भी ठीक करने की ज़रूरत नहीं है। जब भी वे तैयार हों… आप अपनी आँखें बंद होने दे सकते हैं।",
  "scriptHomeFull07": "चलिए, साथ मिलकर साँस धीमी करें। लंबी साँस छोड़ना आपके शरीर को बताता है कि वह आराम कर सकता है।",
  "scriptHomeFull08": "साँस अंदर… दो… तीन… चार। और बाहर… दो… तीन… चार… पाँच… छह।",
  "scriptHomeFull09": "फिर से। अंदर… दो… तीन… चार। और धीरे-धीरे बाहर… कंधों को ढीला छोड़ते हुए… पाँच… छह।",
  "scriptHomeFull10": "अच्छा। अब साँस को अपनी लय खुद ढूँढ़ने दें।",
  "scriptHomeFull11": "थोड़ी देर में मैं दस से एक तक गिनूँगा। हर अंक के साथ आप सुकून में दुगुना गहरे उतर सकते हैं… और आपको कोशिश नहीं करनी। बस सुनिए।",
  "scriptHomeFull12": "दस… छोड़ते हुए।",
  "scriptHomeFull13": "नौ… अब और नरम।",
  "scriptHomeFull14": "आठ… घर की आवाज़ें और दूर होती हुई।",
  "scriptHomeFull15": "सात…",
  "scriptHomeFull16": "छह… और गहरा, और शांत।",
  "scriptHomeFull17": "पाँच… आधा रास्ता, और आराम से।",
  "scriptHomeFull18": "चार…",
  "scriptHomeFull19": "तीन… हर साँस आपको और नीचे ले जाती हुई।",
  "scriptHomeFull20": "दो… लगभग पहुँच गए।",
  "scriptHomeFull21": "और एक।",
  "scriptHomeFull22": "यहीं आराम करते हुए। शांत। सुरक्षित।",
  "scriptHomeFull23": "घर का तनाव अक्सर कुछ गिनी-चुनी जगहों पर बैठ जाता है। चलिए, हर एक तक चलते हैं… और उसे नरम होने देते हैं।",
  "scriptHomeFull24": "माथे से शुरू करें। वह जगह जो घर में शोर बढ़ने पर कस जाती है। कल्पना करें कि एक गर्म हथेली वहाँ टिकी है… उसे सहलाकर सीधा करती हुई…",
  "scriptHomeFull25": "अब जबड़ा। दाँतों को थोड़ा अलग होने दें। जीभ को आराम करने दें। घर में कितनी ही बातें अनकही रह जाती हैं… और अब आप उन्हें छोड़ सकते हैं।",
  "scriptHomeFull26": "गर्दन और कंधे। सोचिए कि वे हर काम और हर उस इंसान का बोझ उठाए हैं जिसे आपसे कुछ चाहिए था… और अब, अगली साँस छोड़ते हुए… वे नीचे गिर जाते हैं। भारी। गर्म।",
  "scriptHomeFull27": "बाँहों से नीचे की ओर… आपके हाथ, जिन्होंने खाना बनाया, सामान उठाया, घर सँवारा और किसी को थामा… उंगलियों को ढीला और स्थिर होने दें।",
  "scriptHomeFull28": "अब सीना और पेट। देखें कि वहाँ कोई भारीपन तो नहीं, अपनों की चिंता की कोई गाँठ। उससे लड़ने की ज़रूरत नहीं।",
  "scriptHomeFull29": "बस उसमें साँस भरें… और साँस छोड़ते हुए कल्पना करें कि वह ढीली हो रही है… एक-एक धागा।",
  "scriptHomeFull30": "कमर का निचला हिस्सा… कूल्हे… टाँगें… नीचे पैरों तक। ज़मीन से जुड़े। सहारे में। अभी कुछ भी थामे रखने की ज़रूरत नहीं।",
  "scriptHomeFull31": "आपका पूरा शरीर, शांत, भारी और सुरक्षित।",
  "scriptHomeFull32": "अब कल्पना करें कि आप एक गर्म अलाव के पास बैठे हैं, बिलकुल ऐप वाले जैसा। आपके चेहरे पर उसकी चमक। लकड़ी की हल्की चटकन।",
  "scriptHomeFull33": "ध्यान दें, आग कभी जल्दी नहीं करती। वह धीरे-धीरे, लगातार जलती है… बिना कोशिश के पूरे कमरे को गर्म करती हुई।",
  "scriptHomeFull34": "घर में आप भी ऐसे हो सकते हैं। स्थिर। गर्मजोशी भरे। काफ़ी होने के लिए आपको सब कुछ करने की ज़रूरत नहीं।",
  "scriptHomeFull35": "और जब आप यहाँ आराम कर रहे हैं, इन शब्दों को कहीं गहरे उतरने दें, जहाँ वे चुपचाप आपके लिए काम कर सकें:",
  "scriptHomeFull36": "मैं दूसरों का ख़याल रखते हुए भी अपना ख़याल रख सकता हूँ।",
  "scriptHomeFull37": "आराम कोई ऐसी चीज़ नहीं जिसे मुझे कमाना पड़े।",
  "scriptHomeFull38": "मुझे आज ही सब कुछ ठीक नहीं करना है।",
  "scriptHomeFull39": "घर में सुकून की शुरुआत मुझसे हो सकती है।",
  "scriptHomeFull40": "अब धीरे से अपने अंगूठे का सिरा तर्जनी उंगली के सिरे से मिलाएँ।",
  "scriptHomeFull41": "एक धीमी साँस लें… और मन ही मन खुद से कहें: मैं अपने भीतर घर पर हूँ।",
  "scriptHomeFull42": "महसूस करें कि यह सुकून आपकी उंगलियों के सिरों पर इकट्ठा हो रहा है। अब से, जब भी घर भारी लगे… किसी ऊँची आवाज़ में, कामों के ढेर में, किसी लंबी शाम में…",
  "scriptHomeFull43": "आप अंगूठा और उंगली मिला सकते हैं, एक साँस ले सकते हैं, और यही सुकून लौट आएगा, हर बार थोड़ा और मज़बूत।",
  "scriptHomeFull44": "अब उंगलियाँ छोड़ दें।",
