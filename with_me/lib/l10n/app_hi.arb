  "scriptEvents11": "थोड़ी देर में मैं दस से एक तक गिनूँगा। हर अंक के साथ आप सुकून में दुगुना गहरे उतर सकते हैं… और आपको कोशिश नहीं करनी। बस सुनिए।",
  "scriptEvents12": "दस… छोड़ते हुए।",
  "scriptEvents13": "नौ… अब और नरम।",
  "scriptEvents14": "आठ… दिन का शोर और दूर होता हुआ।",
  "scriptEvents15": "सात…",
  "scriptEvents16": "छह… और गहरा, और शांत।",
  "scriptEvents17": "पाँच… आधा रास्ता, और आराम से।",
  "scriptEvents18": "चार…",
  "scriptEvents19": "तीन… हर साँस आपको और नीचे ले जाती हुई।",
  "scriptEvents20": "दो… लगभग पहुँच गए।",
  "scriptEvents21": "और एक।",
  "scriptEvents22": "यहीं आराम करते हुए। शांत। सुरक्षित।",
  "scriptEvents23": "अब धीरे-धीरे पूरे शरीर से होकर चलते हैं… और तनाव को नरम होने देते हैं, जहाँ भी वह छिपा हो।",
  "scriptEvents24": "अपना ध्यान पेट पर लाएँ। वहाँ की घबराई हुई ऊर्जा को महसूस करें। धीरे-धीरे उसमें साँस भरें।",
  "scriptEvents25": "अब कंधे। उन्हें नीचे आने दें… और कल्पना करें कि आप पहले से ही सहज हैं, पहले से ही आराम में।",
  "scriptEvents26": "एक पल लेकर धीरे से देखें कि कहीं कुछ अब भी जकड़ा तो नहीं… सिकुड़ी भौंहें, भिंचा हुआ हाथ, रुकी हुई साँस। जहाँ भी मिले, साँस अंदर लें… और साँस छोड़ते हुए उसे पिघल जाने दें।",
  "scriptEvents27": "कूल्हों से नीचे… टाँगें… नीचे ज़मीन पर टिके पैरों तक। ज़मीन से जुड़े। सहारे में। अभी कुछ भी थामे रखने की ज़रूरत नहीं।",
  "scriptEvents28": "आपका पूरा शरीर… शांत, भारी और सुरक्षित। कुछ शांत साँसों तक इस एहसास का आनंद लें।",
  "scriptEvents29": "खुद को हल्की सुनहरी रोशनी से भरे एक कमरे में जाते हुए देखें।",
  "scriptEvents30": "लोग मुड़कर मुस्कुराते हैं। कोई हाथ हिलाता है। आपका स्वागत है, आप सहज हैं। आपको किसी को प्रभावित करने की ज़रूरत नहीं। आप बस यहाँ हैं।",
  "scriptEvents31": "और जब आप यहाँ आराम कर रहे हैं, इन शब्दों को कहीं गहरे उतरने दें, जहाँ वे चुपचाप आपके लिए काम कर सकें:",
  "scriptEvents32": "आपको कोई दिखावा नहीं करना। खुद होना ही काफ़ी है।",
  "scriptEvents33": "ज़्यादातर लोग अपने बारे में सोच रहे होते हैं, आपको परख नहीं रहे।",
  "scriptEvents34": "आप कभी भी एक साँस के लिए बाहर जा सकते हैं।",
  "scriptEvents35": "अब धीरे से अपना अंगूठा और तर्जनी आपस में मिलाएँ।",
  "scriptEvents36": "एक धीमी साँस लें… और मन ही मन खुद से कहें: मैं जो हूँ, वही काफ़ी है।",
  "scriptEvents37": "महसूस करें कि यह सुकून यहीं इकट्ठा हो रहा है। अब से, किसी कार्यक्रम के दरवाज़े पर, या नए लोगों से मिलने से पहले, आप फिर से ऐसा कर सकते हैं… एक साँस लें… और यही सुकून लौट आएगा, हर बार थोड़ा और मज़बूत।",
  "scriptEvents38": "अब इसे छोड़ दें।",
  "scriptEvents39": "अब यहीं आराम करें… कुछ करना नहीं, कहीं जाना नहीं… बस सुकून को भीतर बैठने दें, हर साँस के साथ और गहरा।",
  "scriptEvents40": "लौटने से पहले… अगले कार्यक्रम में करने के लिए एक छोटी, आसान चीज़ चुनें… जैसे बस एक नमस्ते।",
  "scriptEvents41": "खुद को उसे शांति से करते हुए देखें।",
  "scriptEvents42": "अब मैं एक से पाँच तक गिनूँगा। हर अंक के साथ आप ज़्यादा जागे हुए, ज़्यादा सजग महसूस करेंगे… सुकून को साथ लेकर।",
  "scriptEvents43": "एक… अपने नीचे के सहारे को महसूस करते हुए।",
  "scriptEvents44": "दो… कमरे की आवाज़ें लौटती हुईं।",
  "scriptEvents45": "तीन… एक गहरी साँस, हाथों और पैरों की उंगलियाँ हिलाते हुए।",
  "scriptEvents46": "चार… ऊर्जा लौटती हुई, साफ़ और केंद्रित।",
  "scriptEvents47": "और पाँच… जब तैयार हों तो आँखें खोलें… शांत, साफ़ और तैयार।",
  "scriptEvents48": "बहुत बढ़िया। याद रखें: मैं जो हूँ, वही काफ़ी है। मैं यहाँ आपके साथ हूँ।",
  "meditateLonelinessTitle": "कभी सच में अकेले नहीं",
  "afterAnchorLoneliness": "खुद को गले लगाएँ · “मैं अपने साथ हूँ।”",
  "scriptLoneliness01": "नमस्ते। मैं यहाँ आपके साथ हूँ।",
  "scriptLoneliness02": "अकेलापन भारी और ख़ामोश लग सकता है। इन दस मिनटों के लिए, आप अकेले नहीं हैं। मैं यहाँ आपके साथ हूँ।",
  "scriptLoneliness03": "ऐसी स्थिति ढूँढ़ें जिसमें आपके शरीर को सहारा मिले। पैर ज़मीन पर सपाट। हाथ जहाँ टिकना चाहें, वहीं टिके रहें।",
  "scriptLoneliness04": "अब अपनी आँखों को सामने कोई एक छोटा-सा बिंदु ढूँढ़ने दें… और बस अपनी नज़र वहीं टिका दें।",
  "scriptLoneliness05": "उसे देखते रहें… और ध्यान दें कि आपकी पलकें शायद थोड़ी भारी होने लगी हैं… झपकने में थोड़ी धीमी।",
  "scriptLoneliness06": "कुछ भी सही करने की ज़रूरत नहीं है। जब भी वे तैयार हों… आप अपनी आँखें बंद होने दे सकते हैं।",
  "scriptLoneliness07": "चलिए, साथ मिलकर साँस धीमी करें। लंबी साँस छोड़ना आपके शरीर को बताता है कि आप सुरक्षित हैं।",
  "scriptLoneliness08": "साँस अंदर… दो… तीन… चार। और बाहर… दो… तीन… चार… पाँच… छह।",
