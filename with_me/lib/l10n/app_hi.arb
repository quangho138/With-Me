  "afterAnchorColleagues": "धीरे से साँस छोड़ें · “इसे बहकर निकल जाने दें।”",
  "scriptColleagues01": "नमस्ते। मैं यहाँ आपके साथ हूँ।",
  "scriptColleagues02": "हम यह नहीं चुनते कि किसके साथ काम करें। इन दस मिनटों के लिए, आपको किसी और का मूड सँभालने की ज़रूरत नहीं। बस अपनी साँस।",
  "scriptColleagues03": "ऐसी स्थिति ढूँढ़ें जिसमें आपके शरीर को सहारा मिले। पैर ज़मीन पर सपाट। हाथ जहाँ टिकना चाहें, वहीं टिके रहें।",
  "scriptColleagues04": "अब अपनी आँखों को सामने कोई एक छोटा-सा बिंदु ढूँढ़ने दें… और बस अपनी नज़र वहीं टिका दें।",
  "scriptColleagues05": "उसे देखते रहें… और ध्यान दें कि आपकी पलकें शायद थोड़ी भारी होने लगी हैं… झपकने में थोड़ी धीमी।",
  "scriptColleagues06": "कुछ भी सही करने की ज़रूरत नहीं है। जब भी वे तैयार हों… आप अपनी आँखें बंद होने दे सकते हैं।",
  "scriptColleagues07": "चलिए, साथ मिलकर साँस धीमी करें। लंबी साँस छोड़ना आपके शरीर को बताता है कि आप सुरक्षित हैं।",
  "scriptColleagues08": "साँस अंदर… दो… तीन… चार। और बाहर… दो… तीन… चार… पाँच… छह।",
  "scriptColleagues09": "फिर से। अंदर… दो… तीन… चार। और धीरे-धीरे बाहर… कंधों को ढीला छोड़ते हुए… पाँच… छह।",
  "scriptColleagues10": "अच्छा। अब साँस को अपनी लय खुद ढूँढ़ने दें।",
  "scriptColleagues11": "थोड़ी देर में मैं दस से एक तक गिनूँगा। हर अंक के साथ आप सुकून में दुगुना गहरे उतर सकते हैं… और आपको कोशिश नहीं करनी। बस सुनिए।",
  "scriptColleagues12": "दस… छोड़ते हुए।",
  "scriptColleagues13": "नौ… अब और नरम।",
  "scriptColleagues14": "आठ… दिन का शोर और दूर होता हुआ।",
  "scriptColleagues15": "सात…",
  "scriptColleagues16": "छह… और गहरा, और शांत।",
  "scriptColleagues17": "पाँच… आधा रास्ता, और आराम से।",
  "scriptColleagues18": "चार…",
  "scriptColleagues19": "तीन… हर साँस आपको और नीचे ले जाती हुई।",
  "scriptColleagues20": "दो… लगभग पहुँच गए।",
  "scriptColleagues21": "और एक।",
  "scriptColleagues22": "यहीं आराम करते हुए। शांत। सुरक्षित।",
  "scriptColleagues23": "अब धीरे-धीरे पूरे शरीर से होकर चलते हैं… और तनाव को नरम होने देते हैं, जहाँ भी वह छिपा हो।",
  "scriptColleagues24": "अपना ध्यान जबड़े पर लाएँ। दूसरों से जुड़ा तनाव अक्सर यहीं भिंच जाता है। उसे ढीला लटकने दें।",
  "scriptColleagues25": "अब पेट। अगर वहाँ झुंझलाहट की कोई गाँठ है, तो धीरे से उसमें साँस भरें। उसे गर्म मोम की तरह नरम होने दें।",
  "scriptColleagues26": "एक पल लेकर धीरे से देखें कि कहीं कुछ अब भी जकड़ा तो नहीं… सिकुड़ी भौंहें, भिंचा हुआ हाथ, रुकी हुई साँस। जहाँ भी मिले, साँस अंदर लें… और साँस छोड़ते हुए उसे पिघल जाने दें।",
  "scriptColleagues27": "कूल्हों से नीचे… टाँगें… नीचे ज़मीन पर टिके पैरों तक। ज़मीन से जुड़े। सहारे में। अभी कुछ भी थामे रखने की ज़रूरत नहीं।",
  "scriptColleagues28": "आपका पूरा शरीर… शांत, भारी और सुरक्षित। कुछ शांत साँसों तक इस एहसास का आनंद लें।",
  "scriptColleagues29": "कल्पना करें कि एक साफ़ धारा पहाड़ी ढलान से नीचे बह रही है। उसके रास्ते में पत्थर हैं… कुछ छोटे, कुछ बड़े।",
  "scriptColleagues30": "पानी पत्थरों से लड़ता नहीं। वह आसानी से उनके चारों ओर बहता है, और आगे बढ़ता रहता है। वह साफ़ बना रहता है। आप भी ऐसे ही बह सकते हैं।",
  "scriptColleagues31": "और जब आप यहाँ आराम कर रहे हैं, इन शब्दों को कहीं गहरे उतरने दें, जहाँ वे चुपचाप आपके लिए काम कर सकें:",
  "scriptColleagues32": "आप सिर्फ़ अपने हिस्से को सँभाल सकते हैं। इतना काफ़ी है।",
  "scriptColleagues33": "दूसरों का मूड आपकी ज़िम्मेदारी नहीं है।",
  "scriptColleagues34": "आप नरम रहते हुए भी अपनी सीमाएँ बनाए रख सकते हैं।",
  "scriptColleagues35": "अब धीरे से मुँह से धीमी साँस छोड़ें।",
  "scriptColleagues36": "एक धीमी साँस लें… और मन ही मन खुद से कहें: इसे बहकर निकल जाने दें।",
  "scriptColleagues37": "महसूस करें कि यह सुकून यहीं इकट्ठा हो रहा है। अब से, जब किसी सहकर्मी की बात चुभे, या दफ़्तर का माहौल तनाव भरा हो जाए, आप फिर से ऐसा कर सकते हैं… एक साँस लें… और यही सुकून लौट आएगा, हर बार थोड़ा और मज़बूत।",
  "scriptColleagues38": "अब इसे छोड़ दें।",
  "scriptColleagues39": "अब यहीं आराम करें… कुछ करना नहीं, कहीं जाना नहीं… बस सुकून को भीतर बैठने दें, हर साँस के साथ और गहरा।",
  "scriptColleagues40": "लौटने से पहले… आज की एक बातचीत चुनें जिसका सामना आप प्रतिक्रिया के बजाय शांति से करेंगे।",
  "scriptColleagues41": "खुद को उसे शांति से करते हुए देखें।",
  "scriptColleagues42": "अब मैं एक से पाँच तक गिनूँगा। हर अंक के साथ आप ज़्यादा जागे हुए, ज़्यादा सजग महसूस करेंगे… सुकून को साथ लेकर।",
  "scriptColleagues43": "एक… अपने नीचे के सहारे को महसूस करते हुए।",
  "scriptColleagues44": "दो… कमरे की आवाज़ें लौटती हुईं।",
  "scriptColleagues45": "तीन… एक गहरी साँस, हाथों और पैरों की उंगलियाँ हिलाते हुए।",
  "scriptColleagues46": "चार… ऊर्जा लौटती हुई, साफ़ और केंद्रित।",
  "scriptColleagues47": "और पाँच… जब तैयार हों तो आँखें खोलें… शांत, साफ़ और तैयार।",
  "scriptColleagues48": "बहुत बढ़िया। याद रखें: इसे बहकर निकल जाने दें। मैं यहाँ आपके साथ हूँ।",
  "meditateBurnoutTitle": "बर्नआउट से उबरना",
