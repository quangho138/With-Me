  "scriptManager19": "तीन… हर साँस आपको और नीचे ले जाती हुई।",
  "scriptManager20": "दो… लगभग पहुँच गए।",
  "scriptManager21": "और एक।",
  "scriptManager22": "यहीं आराम करते हुए। शांत। सुरक्षित।",
  "scriptManager23": "अब धीरे-धीरे पूरे शरीर से होकर चलते हैं… और तनाव को नरम होने देते हैं, जहाँ भी वह छिपा हो।",
  "scriptManager24": "अपना ध्यान गले पर लाएँ। उसे खुलने और नरम होने दें… एक शांत, साफ़ आवाज़ के लिए तैयार।",
  "scriptManager25": "अब रीढ़। महसूस करें कि वह धीरे से लंबी हो रही है, कमर के निचले हिस्से से गर्दन के ऊपर तक। सीधी, पर ढीली।",
  "scriptManager26": "एक पल लेकर धीरे से देखें कि कहीं कुछ अब भी जकड़ा तो नहीं… सिकुड़ी भौंहें, भिंचा हुआ हाथ, रुकी हुई साँस। जहाँ भी मिले, साँस अंदर लें… और साँस छोड़ते हुए उसे पिघल जाने दें।",
  "scriptManager27": "कूल्हों से नीचे… टाँगें… नीचे ज़मीन पर टिके पैरों तक। ज़मीन से जुड़े। सहारे में। अभी कुछ भी थामे रखने की ज़रूरत नहीं।",
  "scriptManager28": "आपका पूरा शरीर… शांत, भारी और सुरक्षित। कुछ शांत साँसों तक इस एहसास का आनंद लें।",
  "scriptManager29": "हवा भरी चट्टान पर खड़े एक ऊँचे पेड़ की कल्पना करें। तेज़ झोंके आते हैं, और पेड़ झुक जाता है, उसकी पत्तियाँ सरसराती हैं।",
  "scriptManager30": "पर वह टूटता नहीं। वह झुकता है… और फिर सीधा खड़ा हो जाता है। हर तूफ़ान उसकी जड़ों को थोड़ा और मज़बूत बना देता है। वह पेड़ आप हैं।",
  "scriptManager31": "और जब आप यहाँ आराम कर रहे हैं, इन शब्दों को कहीं गहरे उतरने दें, जहाँ वे चुपचाप आपके लिए काम कर सकें:",
  "scriptManager32": "फ़ीडबैक एक जानकारी है, आपके बारे में कोई फ़ैसला नहीं।",
  "scriptManager33": "आप साफ़ और शांति से बोल सकते हैं।",
  "scriptManager34": "आपने यहाँ अपनी जगह खुद कमाई है।",
  "scriptManager35": "अब धीरे से सीधे बैठें और ठोड़ी को सीधा टिकने दें।",
  "scriptManager36": "एक धीमी साँस लें… और मन ही मन खुद से कहें: पाँव ज़मीन पर, मन साफ़।",
  "scriptManager37": "महसूस करें कि यह सुकून यहीं इकट्ठा हो रहा है। अब से, किसी वन-टू-वन मीटिंग या रिव्यू से पहले, या जब आपसे कोई मुश्किल सवाल पूछा जाए, आप फिर से ऐसा कर सकते हैं… एक साँस लें… और यही सुकून लौट आएगा, हर बार थोड़ा और मज़बूत।",
  "scriptManager38": "अब इसे छोड़ दें।",
  "scriptManager39": "अब यहीं आराम करें… कुछ करना नहीं, कहीं जाना नहीं… बस सुकून को भीतर बैठने दें, हर साँस के साथ और गहरा।",
  "scriptManager40": "लौटने से पहले… एक बात के बारे में सोचें जो आप मैनेजर के साथ अपनी अगली बातचीत में साफ़-साफ़ कहना चाहेंगे।",
  "scriptManager41": "खुद को उसे शांति से करते हुए देखें।",
  "scriptManager42": "अब मैं एक से पाँच तक गिनूँगा। हर अंक के साथ आप ज़्यादा जागे हुए, ज़्यादा सजग महसूस करेंगे… सुकून को साथ लेकर।",
  "scriptManager43": "एक… अपने नीचे के सहारे को महसूस करते हुए।",
  "scriptManager44": "दो… कमरे की आवाज़ें लौटती हुईं।",
  "scriptManager45": "तीन… एक गहरी साँस, हाथों और पैरों की उंगलियाँ हिलाते हुए।",
  "scriptManager46": "चार… ऊर्जा लौटती हुई, साफ़ और केंद्रित।",
  "scriptManager47": "और पाँच… जब तैयार हों तो आँखें खोलें… शांत, साफ़ और तैयार।",
  "scriptManager48": "बहुत बढ़िया। याद रखें: पाँव ज़मीन पर, मन साफ़। मैं यहाँ आपके साथ हूँ।",
