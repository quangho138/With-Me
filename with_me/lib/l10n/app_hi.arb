  "scriptSchoolFull23": "पढ़ाई अक्सर कुछ गिनी-चुनी जगहों पर तनाव छोड़ जाती है। चलिए, हर एक तक चलते हैं… और उसे नरम होने देते हैं।",
  "scriptSchoolFull24": "माथे से शुरू करें। वह जगह जो नोट्स और स्क्रीन पर सिकुड़ जाती है। कल्पना करें कि एक गर्म हथेली वहाँ टिकी है… उसे सहलाकर सीधा करती हुई…",
  "scriptSchoolFull25": "अब जबड़ा। दाँतों को थोड़ा अलग होने दें। जीभ को आराम करने दें। कितनी ही एकाग्रता जबड़े में अटकी रहती है… और अब आप उसे छोड़ सकते हैं।",
  "scriptSchoolFull26": "गर्दन और कंधे। सोचिए कि वे घंटों किताबों और लैपटॉप पर झुके रहे हैं… और अब, अगली साँस छोड़ते हुए… वे नीचे गिर जाते हैं। भारी। गर्म।",
  "scriptSchoolFull27": "बाँहों से नीचे की ओर… कलाइयाँ, लिखते-लिखते थकी हुई… हाथ। उंगलियों को ढीला और स्थिर होने दें।",
  "scriptSchoolFull28": "अब सीना और पेट। देखें कि वहाँ कोई जकड़न तो नहीं, नंबरों या आगे की चिंता की कोई गाँठ। उससे लड़ने की ज़रूरत नहीं।",
  "scriptSchoolFull29": "बस उसमें साँस भरें… और साँस छोड़ते हुए कल्पना करें कि वह ढीली हो रही है… एक-एक धागा।",
  "scriptSchoolFull30": "कमर का निचला हिस्सा… कूल्हे… टाँगें… नीचे ज़मीन पर टिके पैरों तक। ज़मीन से जुड़े। सहारे में। अभी कुछ भी थामे रखने की ज़रूरत नहीं।",
  "scriptSchoolFull31": "आपका पूरा शरीर, शांत, भारी और सुरक्षित।",
  "scriptSchoolFull32": "अब कल्पना करें कि आप एक शांत, बर्फ़ से ढके मैदान में खड़े हैं, बिलकुल ऐप वाले जैसा। ठंडी, ताज़ा हवा। चारों ओर नरम बर्फ़ गिरती हुई।",
  "scriptSchoolFull33": "ध्यान दें, हर हिमकण अपने ही समय में गिरता है। वह कभी जल्दी नहीं करता… बस उतर जाता है, और अगले के लिए जगह बना देता है।",
  "scriptSchoolFull34": "आपकी पढ़ाई भी ऐसी हो सकती है। एक पन्ना। एक विषय। फिर अगला।",
  "scriptSchoolFull35": "और जब आप यहाँ आराम कर रहे हैं, इन शब्दों को कहीं गहरे उतरने दें, जहाँ वे चुपचाप आपके लिए काम कर सकें:",
  "scriptSchoolFull36": "मैं अपने नंबरों से कहीं ज़्यादा हूँ।",
  "scriptSchoolFull37": "मैंने पहले भी मुश्किल चीज़ें सीखी हैं, और यह भी सीख सकता हूँ।",
  "scriptSchoolFull38": "आराम पाया मन घबराए मन से ज़्यादा याद रखता है।",
  "scriptSchoolFull39": "हर दिन उठाए छोटे कदम मिलकर बड़े बन जाते हैं।",
  "scriptSchoolFull40": "अब धीरे से अपने अंगूठे का सिरा तर्जनी उंगली के सिरे से मिलाएँ।",
  "scriptSchoolFull41": "एक धीमी साँस लें… और मन ही मन खुद से कहें: एक समय में एक पन्ना।",
  "scriptSchoolFull42": "महसूस करें कि यह सुकून आपकी उंगलियों के सिरों पर इकट्ठा हो रहा है। अब से, जब भी पढ़ाई में दबाव बढ़े… परीक्षा से पहले, भरी हुई लाइब्रेरी में, जब कामों की सूची ख़त्म ही न होती लगे…",
  "scriptSchoolFull43": "आप अंगूठा और उंगली मिला सकते हैं, एक साँस ले सकते हैं, और यही सुकून लौट आएगा, हर बार थोड़ा और मज़बूत।",
  "scriptSchoolFull44": "अब उंगलियाँ छोड़ दें।",
  "scriptSchoolFull45": "लौटने से पहले, एक छोटी-सी चीज़ चुनें जो आप आगे पढ़ेंगे। बस एक। पहला पन्ना, पूरी किताब नहीं।",
  "scriptSchoolFull46": "खुद को उसे शांति से करते हुए देखें।",
  "scriptSchoolFull47": "अब मैं एक से पाँच तक गिनूँगा। हर अंक के साथ आप ज़्यादा जागे हुए, ज़्यादा सजग महसूस करेंगे… सुकून को साथ लेकर।",
  "scriptSchoolFull48": "एक… नीचे की कुर्सी को महसूस करते हुए।",
  "scriptSchoolFull49": "दो… कमरे की आवाज़ें लौटती हुईं।",
  "scriptSchoolFull50": "तीन… एक गहरी साँस, हाथों और पैरों की उंगलियाँ हिलाते हुए।",
  "scriptSchoolFull51": "चार… ऊर्जा लौटती हुई, साफ़ और केंद्रित।",
  "scriptSchoolFull52": "और पाँच… जब तैयार हों तो आँखें खोलें, शांत, साफ़ और तैयार।",
  "scriptSchoolFull53": "बहुत बढ़िया। याद रखें: एक समय में एक पन्ना। मैं यहाँ आपके साथ हूँ।",
  "scriptSocialFull01": "नमस्ते। मैं यहाँ आपके साथ हूँ।",
  "scriptSocialFull02": "अगले दस मिनट के लिए दूसरे क्या सोचते हैं, वह दरवाज़े के बाहर इंतज़ार कर सकता है। बातचीत, संदेश, कही गई बातों को बार-बार दोहराना। आप उनके पास ज़्यादा स्थिर होकर लौटेंगे।",
  "scriptSocialFull03": "ऐसी स्थिति ढूँढ़ें जिसमें आपके शरीर को सहारा मिले। पैर ज़मीन पर सपाट। हाथ जहाँ टिकना चाहें, वहीं टिके रहें।",
  "scriptSocialFull04": "अब अपनी आँखों को सामने कोई एक छोटा-सा बिंदु ढूँढ़ने दें… दीवार पर कोई निशान, रोशनी का कोई टुकड़ा… और बस अपनी नज़र वहीं टिका दें।",
  "scriptSocialFull05": "उसे देखते रहें… और ध्यान दें कि आपकी पलकें शायद थोड़ी भारी होने लगी हैं… झपकने में थोड़ी धीमी।",
  "scriptSocialFull06": "कुछ भी सही कहने या करने की ज़रूरत नहीं है। जब भी वे तैयार हों… आप अपनी आँखें बंद होने दे सकते हैं।",
  "scriptSocialFull07": "चलिए, साथ मिलकर साँस धीमी करें। लंबी साँस छोड़ना आपके शरीर को बताता है कि आप सुरक्षित हैं।",
  "scriptSocialFull08": "साँस अंदर… दो… तीन… चार। और बाहर… दो… तीन… चार… पाँच… छह।",
  "scriptSocialFull09": "फिर से। अंदर… दो… तीन… चार। और धीरे-धीरे बाहर… कंधों को ढीला छोड़ते हुए… पाँच… छह।",
  "scriptSocialFull10": "अच्छा। अब साँस को अपनी लय खुद ढूँढ़ने दें।",
  "scriptSocialFull11": "थोड़ी देर में मैं दस से एक तक गिनूँगा। हर अंक के साथ आप सुकून में दुगुना गहरे उतर सकते हैं… और आपको कोशिश नहीं करनी। बस सुनिए।",
  "scriptSocialFull12": "दस… छोड़ते हुए।",
  "scriptSocialFull13": "नौ… अब और नरम।",
  "scriptSocialFull14": "आठ… दूसरों की आवाज़ें और दूर होती हुई।",
  "scriptSocialFull15": "सात…",
  "scriptSocialFull16": "छह… और गहरा, और शांत।",
  "scriptSocialFull17": "पाँच… आधा रास्ता, और आराम से।",
  "scriptSocialFull18": "चार…",
  "scriptSocialFull19": "तीन… हर साँस आपको और नीचे ले जाती हुई।",
  "scriptSocialFull20": "दो… लगभग पहुँच गए।",
  "scriptSocialFull21": "और एक।",
  "scriptSocialFull22": "यहीं आराम करते हुए। शांत। सुरक्षित।",
  "scriptSocialFull23": "लोगों को लेकर चिंता अक्सर शरीर की कुछ गिनी-चुनी जगहों पर छिपी रहती है। चलिए, हर एक तक चलते हैं… और उसे नरम होने देते हैं।",
  "scriptSocialFull24": "माथे से शुरू करें। वह जगह जो यह सोचकर कस जाती है कि किसी ने क्या सोचा होगा। कल्पना करें कि एक गर्म हथेली वहाँ टिकी है… उसे सहलाकर सीधा करती हुई…",
  "scriptSocialFull25": "अब जबड़ा। दाँतों को थोड़ा अलग होने दें। जीभ को आराम करने दें। कितनी ही अनकही बातें जबड़े में अटकी रहती हैं… और अब आप उन्हें छोड़ सकते हैं।",
  "scriptSocialFull26": "गर्दन और कंधे। सोचिए कि वे लोगों से भरे कमरे के लिए तने हुए हैं… और अब, अगली साँस छोड़ते हुए… वे नीचे गिर जाते हैं। भारी। गर्म।",
  "scriptSocialFull27": "बाँहों से नीचे की ओर… आपके हाथ, शायद बेचैन, यह न जानते हुए कि कहाँ टिकें… उंगलियों को ढीला और स्थिर होने दें।",
  "scriptSocialFull28": "अब सीना और पेट। देखें कि वहाँ कोई धुकधुकी तो नहीं, लोगों से मिलने से पहले घबराहट की कोई गाँठ। उससे लड़ने की ज़रूरत नहीं।",
  "scriptSocialFull29": "बस उसमें साँस भरें… और साँस छोड़ते हुए कल्पना करें कि वह ढीली हो रही है… एक-एक धागा।",
  "scriptSocialFull30": "कमर का निचला हिस्सा… कूल्हे… टाँगें… नीचे ज़मीन पर टिके पैरों तक। ज़मीन से जुड़े। सहारे में। अभी कुछ भी साबित करने की ज़रूरत नहीं।",
  "scriptSocialFull31": "आपका पूरा शरीर, शांत, भारी और सुरक्षित।",
  "scriptSocialFull32": "अब कल्पना करें कि आप एक खुले, चौड़े घास के मैदान में लेटे हैं, बिलकुल ऐप वाले जैसा। नीचे नरम घास। हल्की हवा बहती हुई।",
  "scriptSocialFull33": "ध्यान दें, घास हवा के साथ झुकती है… और कभी टूटती नहीं। वह किसी चीज़ को पकड़े नहीं रहती। झूमती है, और फिर से थम जाती है।",
  "scriptSocialFull34": "लोगों के साथ आप भी ऐसे हो सकते हैं। उस पल को अपने भीतर से गुज़र जाने दें… और फिर खुद पर लौट आएँ।",
  "scriptSocialFull35": "और जब आप यहाँ आराम कर रहे हैं, इन शब्दों को कहीं गहरे उतरने दें, जहाँ वे चुपचाप आपके लिए काम कर सकें:",
  "scriptSocialFull36": "मैं जैसा हूँ, वैसा ही काफ़ी हूँ।",
  "scriptSocialFull37": "ज़्यादातर लोग अपने बारे में सोच रहे होते हैं, मुझे परख नहीं रहे होते।",
  "scriptSocialFull38": "मुझे अपनी जगह लेने का हक़ है।",
  "scriptSocialFull39": "एक प्यारी-सी बातचीत काफ़ी है।",
  "scriptSocialFull40": "अब धीरे से अपने अंगूठे का सिरा तर्जनी उंगली के सिरे से मिलाएँ।",
  "scriptSocialFull41": "एक धीमी साँस लें… और मन ही मन खुद से कहें: मैं जैसा हूँ, वैसा ही यहाँ का हूँ।",
