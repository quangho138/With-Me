  },
  "afterAnchorHomeReset": "One deep sigh · “I'm at home in myself.”",
  "@afterAnchorHomeReset": {
    "description": "The anchor card after Home Reset: the gesture and its words."
  },
  "scriptHomeReset01": "Hi. I'm here with you.",
  "@scriptHomeReset01": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/01.mp3)."
  },
  "scriptHomeReset02": "Sometimes home doesn't feel like home… too loud, too busy, too much. For these ten minutes, let's make a calm space inside you.",
