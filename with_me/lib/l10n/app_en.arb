  },
  "scriptJobSecurity21": "And one.",
  "@scriptJobSecurity21": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/21.mp3)."
  },
  "scriptJobSecurity22": "Resting here. Quiet. Safe.",
  "@scriptJobSecurity22": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/22.mp3)."
  },
  "scriptJobSecurity23": "Now let's move slowly through your body… and let the tension soften, wherever it's hiding.",
  "@scriptJobSecurity23": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/23.mp3)."
  },
  "scriptJobSecurity24": "Bring your attention to your legs. Feel how strong they are… how they've carried you through every challenge so far.",
  "@scriptJobSecurity24": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/24.mp3)."
  },
  "scriptJobSecurity25": "Now your feet. Press them gently into the floor, and feel it press back. Solid. Steady. Here.",
  "@scriptJobSecurity25": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/25.mp3)."
  },
  "scriptJobSecurity26": "Take a moment to search gently for anything still holding on… a tight brow, a clenched hand, a held breath. Wherever you find it, breathe in… and as you breathe out, let it melt away.",
  "@scriptJobSecurity26": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/26.mp3)."
  },
  "scriptJobSecurity27": "Down through your hips… your legs… all the way to your feet on the floor. Grounded. Supported. Nothing to hold up right now.",
  "@scriptJobSecurity27": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/27.mp3)."
  },
  "scriptJobSecurity28": "Your whole body… calm and heavy and safe. Enjoy this feeling for a few quiet breaths.",
  "@scriptJobSecurity28": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/28.mp3)."
  },
  "scriptJobSecurity29": "Picture yourself standing on a wide, solid rock by the sea. The tide comes in… the tide goes out.",
  "@scriptJobSecurity29": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/29.mp3)."
  },
  "scriptJobSecurity30": "The water moves all around you, but the rock doesn't move. You can watch the changes without being swept away.",
  "@scriptJobSecurity30": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/30.mp3)."
  },
  "scriptJobSecurity31": "And as you rest here, let these words settle somewhere deep, where they can quietly work for you:",
  "@scriptJobSecurity31": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/31.mp3)."
  },
  "scriptJobSecurity32": "You have skills and options, even when things feel uncertain.",
  "@scriptJobSecurity32": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/32.mp3)."
  },
  "scriptJobSecurity33": "You've adapted before. You can again.",
  "@scriptJobSecurity33": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/33.mp3)."
  },
  "scriptJobSecurity34": "Today, you only need to handle today.",
  "@scriptJobSecurity34": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/34.mp3)."
  },
  "scriptJobSecurity35": "Now, gently press your feet down into the floor.",
  "@scriptJobSecurity35": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/35.mp3)."
  },
  "scriptJobSecurity36": "Take one slow breath… and silently say to yourself: Solid ground.",
  "@scriptJobSecurity36": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/36.mp3)."
  },
  "scriptJobSecurity37": "Feel this calm gathering here. From now on, when you hear worrying news, or your mind jumps to the worst case, you can do this again… take one breath… and this same calm will return, a little stronger each time.",
  "@scriptJobSecurity37": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/37.mp3)."
  },
  "scriptJobSecurity38": "Let it go now.",
  "@scriptJobSecurity38": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/38.mp3)."
  },
  "scriptJobSecurity39": "Rest here now… nothing to do, nowhere to be… just letting the calm settle in, deeper with every breath.",
  "@scriptJobSecurity39": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/39.mp3)."
  },
  "scriptJobSecurity40": "Before we come back… Think of one skill or strength you have that stays with you, wherever you work.",
  "@scriptJobSecurity40": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/40.mp3)."
  },
  "scriptJobSecurity41": "See yourself doing it calmly.",
  "@scriptJobSecurity41": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/41.mp3)."
  },
  "scriptJobSecurity42": "Now I'll count from one to five. With each number you'll feel more awake, more alert… bringing the calm back with you.",
  "@scriptJobSecurity42": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/42.mp3)."
  },
  "scriptJobSecurity43": "One… noticing what's beneath you.",
  "@scriptJobSecurity43": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/43.mp3)."
  },
  "scriptJobSecurity44": "Two… sounds of the room returning.",
  "@scriptJobSecurity44": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/44.mp3)."
  },
  "scriptJobSecurity45": "Three… a deeper breath, wiggling your fingers and toes.",
  "@scriptJobSecurity45": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/45.mp3)."
  },
  "scriptJobSecurity46": "Four… energy flowing back, clear and focused.",
