  "scriptSchoolReset07": "Let's slow the breath together. A longer out-breath tells your body you are safe.",
  "@scriptSchoolReset07": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/07.mp3)."
  },
  "scriptSchoolReset08": "Breathe in… two… three… four. And out… two… three… four… five… six.",
  "@scriptSchoolReset08": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/08.mp3)."
  },
  "scriptSchoolReset09": "Again. In… two… three… four. And slowly out… letting the shoulders fall… five… six.",
  "@scriptSchoolReset09": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/09.mp3)."
  },
  "scriptSchoolReset10": "Good. Let the breath find its own rhythm now.",
  "@scriptSchoolReset10": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/10.mp3)."
  },
  "scriptSchoolReset11": "In a moment I'll count down from ten to one. With each number, you can drift twice as deep into calm… and you don't have to try. Just listen.",
  "@scriptSchoolReset11": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/11.mp3)."
  },
  "scriptSchoolReset12": "Ten… letting go.",
  "@scriptSchoolReset12": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/12.mp3)."
  },
  "scriptSchoolReset13": "Nine… softer now.",
  "@scriptSchoolReset13": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/13.mp3)."
  },
  "scriptSchoolReset14": "Eight… the noise of the day moving further away.",
  "@scriptSchoolReset14": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/14.mp3)."
  },
  "scriptSchoolReset15": "Seven…",
  "@scriptSchoolReset15": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/15.mp3)."
  },
  "scriptSchoolReset16": "Six… deeper and calmer.",
  "@scriptSchoolReset16": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/16.mp3)."
  },
  "scriptSchoolReset17": "Five… halfway down, and comfortable.",
  "@scriptSchoolReset17": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/17.mp3)."
  },
  "scriptSchoolReset18": "Four…",
  "@scriptSchoolReset18": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/18.mp3)."
  },
  "scriptSchoolReset19": "Three… every breath carrying you down.",
  "@scriptSchoolReset19": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/19.mp3)."
  },
  "scriptSchoolReset20": "Two… almost there.",
  "@scriptSchoolReset20": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/20.mp3)."
  },
  "scriptSchoolReset21": "And one.",
  "@scriptSchoolReset21": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/21.mp3)."
  },
  "scriptSchoolReset22": "Resting here. Quiet. Safe.",
  "@scriptSchoolReset22": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/22.mp3)."
  },
  "scriptSchoolReset23": "Now let's move slowly through your body… and let the tension soften, wherever it's hiding.",
  "@scriptSchoolReset23": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/23.mp3)."
  },
  "scriptSchoolReset24": "Bring your attention to your back and shoulders, where your backpack sits every day. Let them stretch and soften.",
  "@scriptSchoolReset24": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/24.mp3)."
  },
  "scriptSchoolReset25": "Let the rest of your body relax, from your head all the way down to your toes.",
  "@scriptSchoolReset25": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/25.mp3)."
  },
  "scriptSchoolReset26": "Take a moment to search gently for anything still holding on… a tight brow, a clenched hand, a held breath. Wherever you find it, breathe in… and as you breathe out, let it melt away.",
  "@scriptSchoolReset26": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/26.mp3)."
  },
  "scriptSchoolReset27": "Down through your hips… your legs… all the way to your feet on the floor. Grounded. Supported. Nothing to hold up right now.",
  "@scriptSchoolReset27": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/27.mp3)."
  },
  "scriptSchoolReset28": "Your whole body… calm and heavy and safe. Enjoy this feeling for a few quiet breaths.",
  "@scriptSchoolReset28": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/28.mp3)."
  },
  "scriptSchoolReset29": "Imagine taking off a heavy backpack at the front door and leaving it there.",
  "@scriptSchoolReset29": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/29.mp3)."
  },
  "scriptSchoolReset30": "Without it, you feel light. You walk out onto the sand… free to breathe, free to just be you.",
  "@scriptSchoolReset30": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/30.mp3)."
  },
  "scriptSchoolReset31": "And as you rest here, let these words settle somewhere deep, where they can quietly work for you:",
  "@scriptSchoolReset31": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/31.mp3)."
  },
  "scriptSchoolReset32": "You are learning, and learning takes time.",
  "@scriptSchoolReset32": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/32.mp3)."
  },
  "scriptSchoolReset33": "Rest is part of studying.",
  "@scriptSchoolReset33": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/33.mp3)."
  },
  "scriptSchoolReset34": "Tomorrow is a fresh page.",
  "@scriptSchoolReset34": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/34.mp3)."
  },
  "scriptSchoolReset35": "Now, gently stretch your arms up.",
  "@scriptSchoolReset35": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/35.mp3)."
  },
  "scriptSchoolReset36": "Take one slow breath… and silently say to yourself: Fresh page.",
  "@scriptSchoolReset36": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/36.mp3)."
  },
  "scriptSchoolReset37": "Feel this calm gathering here. From now on, after a long school day, or before you start studying, you can do this again… take one breath… and this same calm will return, a little stronger each time.",
  "@scriptSchoolReset37": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/37.mp3)."
  },
  "scriptSchoolReset38": "Let it go now.",
  "@scriptSchoolReset38": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/38.mp3)."
  },
  "scriptSchoolReset39": "Rest here now… nothing to do, nowhere to be… just letting the calm settle in, deeper with every breath.",
  "@scriptSchoolReset39": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/39.mp3)."
  },
  "scriptSchoolReset40": "Before we come back… Choose one thing you'll do just for fun today.",
  "@scriptSchoolReset40": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/40.mp3)."
  },
  "scriptSchoolReset41": "See yourself doing it calmly.",
  "@scriptSchoolReset41": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/41.mp3)."
  },
  "scriptSchoolReset42": "Now I'll count from one to five. With each number you'll feel more awake, more alert… bringing the calm back with you.",
  "@scriptSchoolReset42": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/42.mp3)."
  },
  "scriptSchoolReset43": "One… noticing what's beneath you.",
  "@scriptSchoolReset43": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/43.mp3)."
  },
  "scriptSchoolReset44": "Two… sounds of the room returning.",
  "@scriptSchoolReset44": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/44.mp3)."
  },
  "scriptSchoolReset45": "Three… a deeper breath, wiggling your fingers and toes.",
  "@scriptSchoolReset45": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/45.mp3)."
  },
  "scriptSchoolReset46": "Four… energy flowing back, clear and focused.",
  "@scriptSchoolReset46": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/46.mp3)."
  },
  "scriptSchoolReset47": "And five… eyes open when you're ready… calm, clear and ready.",
  "@scriptSchoolReset47": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/47.mp3)."
  },
  "scriptSchoolReset48": "Well done. Remember: Fresh page. I'm here with you.",
  "@scriptSchoolReset48": {
    "description": "Spoken line of School Reset (recorded as meditate/school_reset/48.mp3)."
  },
  "meditateConflictTitle": "After a Conflict",
  "@meditateConflictTitle": {
    "description": "A social meditation."
  },
  "afterAnchorConflict": "Open your hands · “Let the storm pass.”",
  "@afterAnchorConflict": {
    "description": "The anchor card after After a Conflict: the gesture and its words."
  },
  "scriptConflict01": "Hi. I'm here with you.",
  "@scriptConflict01": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/01.mp3)."
  },
  "scriptConflict02": "After an argument, the words can keep replaying. For these ten minutes, you don't have to replay anything.",
  "@scriptConflict02": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/02.mp3)."
  },
  "scriptConflict03": "Find a position where your body is supported. Feet flat on the floor. Hands resting wherever they want to rest.",
  "@scriptConflict03": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/03.mp3)."
  },
  "scriptConflict04": "Now let your eyes find one small point in front of you… and simply rest your gaze there.",
  "@scriptConflict04": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/04.mp3)."
  },
  "scriptConflict05": "Keep looking at it… and notice how your eyelids may start to feel a little heavier… a little slower to blink.",
  "@scriptConflict05": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/05.mp3)."
  },
  "scriptConflict06": "There's nothing you need to do right. Whenever they're ready… you can let your eyes close.",
  "@scriptConflict06": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/06.mp3)."
  },
  "scriptConflict07": "Let's slow the breath together. A longer out-breath tells your body you are safe.",
  "@scriptConflict07": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/07.mp3)."
  },
  "scriptConflict08": "Breathe in… two… three… four. And out… two… three… four… five… six.",
  "@scriptConflict08": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/08.mp3)."
  },
  "scriptConflict09": "Again. In… two… three… four. And slowly out… letting the shoulders fall… five… six.",
  "@scriptConflict09": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/09.mp3)."
  },
  "scriptConflict10": "Good. Let the breath find its own rhythm now.",
  "@scriptConflict10": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/10.mp3)."
  },
  "scriptConflict11": "In a moment I'll count down from ten to one. With each number, you can drift twice as deep into calm… and you don't have to try. Just listen.",
  "@scriptConflict11": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/11.mp3)."
  },
  "scriptConflict12": "Ten… letting go.",
  "@scriptConflict12": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/12.mp3)."
  },
  "scriptConflict13": "Nine… softer now.",
  "@scriptConflict13": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/13.mp3)."
  },
  "scriptConflict14": "Eight… the noise of the day moving further away.",
  "@scriptConflict14": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/14.mp3)."
  },
  "scriptConflict15": "Seven…",
  "@scriptConflict15": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/15.mp3)."
  },
  "scriptConflict16": "Six… deeper and calmer.",
  "@scriptConflict16": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/16.mp3)."
  },
  "scriptConflict17": "Five… halfway down, and comfortable.",
  "@scriptConflict17": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/17.mp3)."
  },
  "scriptConflict18": "Four…",
  "@scriptConflict18": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/18.mp3)."
  },
  "scriptConflict19": "Three… every breath carrying you down.",
  "@scriptConflict19": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/19.mp3)."
  },
  "scriptConflict20": "Two… almost there.",
  "@scriptConflict20": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/20.mp3)."
  },
  "scriptConflict21": "And one.",
  "@scriptConflict21": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/21.mp3)."
  },
  "scriptConflict22": "Resting here. Quiet. Safe.",
  "@scriptConflict22": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/22.mp3)."
  },
  "scriptConflict23": "Now let's move slowly through your body… and let the tension soften, wherever it's hiding.",
  "@scriptConflict23": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/23.mp3)."
  },
  "scriptConflict24": "Bring your attention to your jaw and your fists. Let them unclench. Open your hands slowly.",
  "@scriptConflict24": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/24.mp3)."
  },
  "scriptConflict25": "Now your chest. If there's heat or hurt, breathe into it. Let each out-breath cool it, like a sea breeze.",
  "@scriptConflict25": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/25.mp3)."
  },
  "scriptConflict26": "Take a moment to search gently for anything still holding on… a tight brow, a clenched hand, a held breath. Wherever you find it, breathe in… and as you breathe out, let it melt away.",
  "@scriptConflict26": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/26.mp3)."
  },
  "scriptConflict27": "Down through your hips… your legs… all the way to your feet on the floor. Grounded. Supported. Nothing to hold up right now.",
  "@scriptConflict27": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/27.mp3)."
  },
  "scriptConflict28": "Your whole body… calm and heavy and safe. Enjoy this feeling for a few quiet breaths.",
  "@scriptConflict28": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/28.mp3)."
  },
  "scriptConflict29": "Imagine a storm passing over the sea. Dark clouds, wind, rain.",
  "@scriptConflict29": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/29.mp3)."
  },
  "scriptConflict30": "And then, slowly, the clouds move on. The sky clears. The water grows still. The storm was real… and it passed.",
  "@scriptConflict30": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/30.mp3)."
  },
  "scriptConflict31": "And as you rest here, let these words settle somewhere deep, where they can quietly work for you:",
  "@scriptConflict31": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/31.mp3)."
  },
  "scriptConflict32": "You can be hurt and still choose calm.",
  "@scriptConflict32": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/32.mp3)."
  },
  "scriptConflict33": "You don't need to win to be at peace.",
  "@scriptConflict33": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/33.mp3)."
  },
  "scriptConflict34": "Repair can wait until you're ready.",
  "@scriptConflict34": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/34.mp3)."
  },
  "scriptConflict35": "Now, gently open your hands, palms up.",
  "@scriptConflict35": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/35.mp3)."
  },
  "scriptConflict36": "Take one slow breath… and silently say to yourself: Let the storm pass.",
  "@scriptConflict36": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/36.mp3)."
  },
  "scriptConflict37": "Feel this calm gathering here. From now on, when anger rises, or the argument starts replaying in your head, you can do this again… take one breath… and this same calm will return, a little stronger each time.",
  "@scriptConflict37": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/37.mp3)."
  },
  "scriptConflict38": "Let it go now.",
  "@scriptConflict38": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/38.mp3)."
  },
  "scriptConflict39": "Rest here now… nothing to do, nowhere to be… just letting the calm settle in, deeper with every breath.",
  "@scriptConflict39": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/39.mp3)."
  },
  "scriptConflict40": "Before we come back… Decide whether something needs repairing, and when you'll be ready. There's no rush.",
  "@scriptConflict40": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/40.mp3)."
  },
  "scriptConflict41": "See yourself doing it calmly.",
  "@scriptConflict41": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/41.mp3)."
  },
  "scriptConflict42": "Now I'll count from one to five. With each number you'll feel more awake, more alert… bringing the calm back with you.",
  "@scriptConflict42": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/42.mp3)."
  },
  "scriptConflict43": "One… noticing what's beneath you.",
  "@scriptConflict43": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/43.mp3)."
  },
  "scriptConflict44": "Two… sounds of the room returning.",
  "@scriptConflict44": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/44.mp3)."
  },
  "scriptConflict45": "Three… a deeper breath, wiggling your fingers and toes.",
  "@scriptConflict45": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/45.mp3)."
  },
  "scriptConflict46": "Four… energy flowing back, clear and focused.",
  "@scriptConflict46": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/46.mp3)."
  },
  "scriptConflict47": "And five… eyes open when you're ready… calm, clear and ready.",
  "@scriptConflict47": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/47.mp3)."
  },
  "scriptConflict48": "Well done. Remember: Let the storm pass. I'm here with you.",
  "@scriptConflict48": {
    "description": "Spoken line of After a Conflict (recorded as meditate/conflict/48.mp3)."
  },
