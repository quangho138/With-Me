  },
  "scriptFamily01": "Hi. I'm here with you.",
  "@scriptFamily01": {
    "description": "Spoken line of Peace with Family (recorded as meditate/family/01.mp3)."
  },
  "scriptFamily02": "Family knows exactly where our buttons are. For these ten minutes, you can step back from old roles and simply be yourself.",
  "@scriptFamily02": {
    "description": "Spoken line of Peace with Family (recorded as meditate/family/02.mp3)."
  },
  "scriptFamily03": "Find a position where your body is supported. Feet flat on the floor. Hands resting wherever they want to rest.",
  "@scriptFamily03": {
    "description": "Spoken line of Peace with Family (recorded as meditate/family/03.mp3)."
  },
  "scriptFamily04": "Now let your eyes find one small point in front of you… and simply rest your gaze there.",
  "@scriptFamily04": {
