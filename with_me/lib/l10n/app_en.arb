  "scriptWorkReset22": "Resting here. Quiet. Safe.",
  "@scriptWorkReset22": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/22.mp3)."
  },
  "scriptWorkReset23": "Now let's move slowly through your body… and let the tension soften, wherever it's hiding.",
  "@scriptWorkReset23": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/23.mp3)."
  },
  "scriptWorkReset24": "Start with your eyes, tired from screens… then your neck and shoulders. Let each one relax as your attention passes over it.",
  "@scriptWorkReset24": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/24.mp3)."
  },
  "scriptWorkReset25": "Notice the posture you hold at your desk… and let your body unfold from it. Loose. Free.",
  "@scriptWorkReset25": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/25.mp3)."
  },
  "scriptWorkReset26": "Take a moment to search gently for anything still holding on… a tight brow, a clenched hand, a held breath. Wherever you find it, breathe in… and as you breathe out, let it melt away.",
  "@scriptWorkReset26": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/26.mp3)."
  },
  "scriptWorkReset27": "Down through your hips… your legs… all the way to your feet on the floor. Grounded. Supported. Nothing to hold up right now.",
  "@scriptWorkReset27": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/27.mp3)."
  },
  "scriptWorkReset28": "Your whole body… calm and heavy and safe. Enjoy this feeling for a few quiet breaths.",
  "@scriptWorkReset28": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/28.mp3)."
  },
  "scriptWorkReset29": "Imagine closing the office door behind you and stepping straight onto an evening beach.",
  "@scriptWorkReset29": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/29.mp3)."
  },
  "scriptWorkReset30": "The sky is soft orange. The air is cool. With every step on the sand, the workday falls further behind you.",
  "@scriptWorkReset30": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/30.mp3)."
  },
  "scriptWorkReset31": "And as you rest here, let these words settle somewhere deep, where they can quietly work for you:",
  "@scriptWorkReset31": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/31.mp3)."
  },
  "scriptWorkReset32": "One task at a time is enough.",
  "@scriptWorkReset32": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/32.mp3)."
  },
  "scriptWorkReset33": "A hard day is not a hard life.",
  "@scriptWorkReset33": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/33.mp3)."
  },
  "scriptWorkReset34": "You can leave work at work.",
  "@scriptWorkReset34": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/34.mp3)."
  },
  "scriptWorkReset35": "Now, gently close your laptop or phone and take one breath.",
  "@scriptWorkReset35": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/35.mp3)."
  },
  "scriptWorkReset36": "Take one slow breath… and silently say to yourself: Done for now.",
  "@scriptWorkReset36": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/36.mp3)."
  },
  "scriptWorkReset37": "Feel this calm gathering here. From now on, at the end of the workday, or when you need a reset between tasks, you can do this again… take one breath… and this same calm will return, a little stronger each time.",
  "@scriptWorkReset37": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/37.mp3)."
  },
  "scriptWorkReset38": "Let it go now.",
  "@scriptWorkReset38": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/38.mp3)."
  },
  "scriptWorkReset39": "Rest here now… nothing to do, nowhere to be… just letting the calm settle in, deeper with every breath.",
  "@scriptWorkReset39": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/39.mp3)."
  },
  "scriptWorkReset40": "Before we come back… Choose one thing you'll do tonight that has nothing to do with work.",
  "@scriptWorkReset40": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/40.mp3)."
  },
  "scriptWorkReset41": "See yourself doing it calmly.",
  "@scriptWorkReset41": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/41.mp3)."
  },
  "scriptWorkReset42": "Now I'll count from one to five. With each number you'll feel more awake, more alert… bringing the calm back with you.",
  "@scriptWorkReset42": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/42.mp3)."
  },
  "scriptWorkReset43": "One… noticing what's beneath you.",
  "@scriptWorkReset43": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/43.mp3)."
  },
  "scriptWorkReset44": "Two… sounds of the room returning.",
  "@scriptWorkReset44": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/44.mp3)."
  },
  "scriptWorkReset45": "Three… a deeper breath, wiggling your fingers and toes.",
  "@scriptWorkReset45": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/45.mp3)."
  },
  "scriptWorkReset46": "Four… energy flowing back, clear and focused.",
  "@scriptWorkReset46": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/46.mp3)."
  },
  "scriptWorkReset47": "And five… eyes open when you're ready… calm, clear and ready.",
  "@scriptWorkReset47": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/47.mp3)."
  },
  "scriptWorkReset48": "Well done. Remember: Done for now. I'm here with you.",
  "@scriptWorkReset48": {
    "description": "Spoken line of Work Reset (recorded as meditate/work_reset/48.mp3)."
  },
  "meditateHomeworkTitle": "Homework Focus",
  "@meditateHomeworkTitle": {
    "description": "A school meditation."
  },
  "afterAnchorHomework": "A five-minute timer · “Just begin.”",
  "@afterAnchorHomework": {
    "description": "The anchor card after Homework Focus: the gesture and its words."
  },
  "scriptHomework01": "Hi. I'm here with you.",
  "@scriptHomework01": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/01.mp3)."
  },
  "scriptHomework02": "Sometimes the hardest part of homework is starting. For these ten minutes, you don't have to start anything. Just rest.",
  "@scriptHomework02": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/02.mp3)."
  },
  "scriptHomework03": "Find a position where your body is supported. Feet flat on the floor. Hands resting wherever they want to rest.",
  "@scriptHomework03": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/03.mp3)."
  },
  "scriptHomework04": "Now let your eyes find one small point in front of you… and simply rest your gaze there.",
  "@scriptHomework04": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/04.mp3)."
  },
  "scriptHomework05": "Keep looking at it… and notice how your eyelids may start to feel a little heavier… a little slower to blink.",
  "@scriptHomework05": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/05.mp3)."
  },
  "scriptHomework06": "There's nothing you need to do right. Whenever they're ready… you can let your eyes close.",
  "@scriptHomework06": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/06.mp3)."
  },
  "scriptHomework07": "Let's slow the breath together. A longer out-breath tells your body you are safe.",
  "@scriptHomework07": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/07.mp3)."
  },
  "scriptHomework08": "Breathe in… two… three… four. And out… two… three… four… five… six.",
  "@scriptHomework08": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/08.mp3)."
  },
  "scriptHomework09": "Again. In… two… three… four. And slowly out… letting the shoulders fall… five… six.",
  "@scriptHomework09": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/09.mp3)."
  },
  "scriptHomework10": "Good. Let the breath find its own rhythm now.",
  "@scriptHomework10": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/10.mp3)."
  },
  "scriptHomework11": "In a moment I'll count down from ten to one. With each number, you can drift twice as deep into calm… and you don't have to try. Just listen.",
  "@scriptHomework11": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/11.mp3)."
  },
  "scriptHomework12": "Ten… letting go.",
  "@scriptHomework12": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/12.mp3)."
  },
  "scriptHomework13": "Nine… softer now.",
  "@scriptHomework13": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/13.mp3)."
  },
  "scriptHomework14": "Eight… the noise of the day moving further away.",
  "@scriptHomework14": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/14.mp3)."
  },
  "scriptHomework15": "Seven…",
  "@scriptHomework15": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/15.mp3)."
  },
  "scriptHomework16": "Six… deeper and calmer.",
  "@scriptHomework16": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/16.mp3)."
  },
  "scriptHomework17": "Five… halfway down, and comfortable.",
  "@scriptHomework17": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/17.mp3)."
  },
  "scriptHomework18": "Four…",
  "@scriptHomework18": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/18.mp3)."
  },
  "scriptHomework19": "Three… every breath carrying you down.",
  "@scriptHomework19": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/19.mp3)."
  },
  "scriptHomework20": "Two… almost there.",
  "@scriptHomework20": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/20.mp3)."
  },
  "scriptHomework21": "And one.",
  "@scriptHomework21": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/21.mp3)."
  },
  "scriptHomework22": "Resting here. Quiet. Safe.",
  "@scriptHomework22": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/22.mp3)."
  },
  "scriptHomework23": "Now let's move slowly through your body… and let the tension soften, wherever it's hiding.",
  "@scriptHomework23": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/23.mp3)."
  },
  "scriptHomework24": "Bring your attention to your eyes and forehead. Let them soften after hours of screens and pages.",
  "@scriptHomework24": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/24.mp3)."
  },
  "scriptHomework25": "Now your neck. Let your head feel heavy and supported, as if resting on a soft pillow.",
  "@scriptHomework25": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/25.mp3)."
  },
  "scriptHomework26": "Take a moment to search gently for anything still holding on… a tight brow, a clenched hand, a held breath. Wherever you find it, breathe in… and as you breathe out, let it melt away.",
  "@scriptHomework26": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/26.mp3)."
  },
  "scriptHomework27": "Down through your hips… your legs… all the way to your feet on the floor. Grounded. Supported. Nothing to hold up right now.",
  "@scriptHomework27": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/27.mp3)."
  },
  "scriptHomework28": "Your whole body… calm and heavy and safe. Enjoy this feeling for a few quiet breaths.",
  "@scriptHomework28": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/28.mp3)."
  },
  "scriptHomework29": "Imagine a gentle sand dune with soft steps carved into it. You don't look at the top. You just take one step.",
  "@scriptHomework29": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/29.mp3)."
  },
  "scriptHomework30": "Then another. And before you know it, you've climbed higher than you expected. Every step was small.",
  "@scriptHomework30": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/30.mp3)."
  },
  "scriptHomework31": "And as you rest here, let these words settle somewhere deep, where they can quietly work for you:",
  "@scriptHomework31": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/31.mp3)."
  },
  "scriptHomework32": "Start small. Five minutes is a real beginning.",
  "@scriptHomework32": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/32.mp3)."
  },
  "scriptHomework33": "Focus grows once you begin.",
  "@scriptHomework33": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/33.mp3)."
  },
  "scriptHomework34": "You don't have to finish it all now.",
  "@scriptHomework34": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/34.mp3)."
  },
  "scriptHomework35": "Now, gently imagine setting a five-minute timer.",
  "@scriptHomework35": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/35.mp3)."
  },
  "scriptHomework36": "Take one slow breath… and silently say to yourself: Just begin.",
  "@scriptHomework36": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/36.mp3)."
  },
  "scriptHomework37": "Feel this calm gathering here. From now on, when you're putting off work, or the pile feels too big, you can do this again… take one breath… and this same calm will return, a little stronger each time.",
  "@scriptHomework37": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/37.mp3)."
  },
  "scriptHomework38": "Let it go now.",
  "@scriptHomework38": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/38.mp3)."
  },
  "scriptHomework39": "Rest here now… nothing to do, nowhere to be… just letting the calm settle in, deeper with every breath.",
  "@scriptHomework39": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/39.mp3)."
  },
  "scriptHomework40": "Before we come back… Choose one task you'll work on for just five minutes after this.",
  "@scriptHomework40": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/40.mp3)."
  },
  "scriptHomework41": "See yourself doing it calmly.",
  "@scriptHomework41": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/41.mp3)."
  },
  "scriptHomework42": "Now I'll count from one to five. With each number you'll feel more awake, more alert… bringing the calm back with you.",
  "@scriptHomework42": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/42.mp3)."
  },
  "scriptHomework43": "One… noticing what's beneath you.",
  "@scriptHomework43": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/43.mp3)."
  },
  "scriptHomework44": "Two… sounds of the room returning.",
  "@scriptHomework44": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/44.mp3)."
  },
  "scriptHomework45": "Three… a deeper breath, wiggling your fingers and toes.",
  "@scriptHomework45": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/45.mp3)."
  },
  "scriptHomework46": "Four… energy flowing back, clear and focused.",
  "@scriptHomework46": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/46.mp3)."
  },
  "scriptHomework47": "And five… eyes open when you're ready… calm, clear and ready.",
  "@scriptHomework47": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/47.mp3)."
  },
  "scriptHomework48": "Well done. Remember: Just begin. I'm here with you.",
  "@scriptHomework48": {
    "description": "Spoken line of Homework Focus (recorded as meditate/homework/48.mp3)."
  },
  "meditateGradesTitle": "Beyond the Grade",
  "@meditateGradesTitle": {
    "description": "A school meditation."
  },
  "afterAnchorGrades": "Hand on chest · “I am more than a score.”",
  "@afterAnchorGrades": {
    "description": "The anchor card after Beyond the Grade: the gesture and its words."
  },
  "scriptGrades01": "Hi. I'm here with you.",
  "@scriptGrades01": {
    "description": "Spoken line of Beyond the Grade (recorded as meditate/grades/01.mp3)."
  },
  "scriptGrades02": "Grades can feel like they decide everything. For these ten minutes, you are more than any number.",
  "@scriptGrades02": {
    "description": "Spoken line of Beyond the Grade (recorded as meditate/grades/02.mp3)."
  },
  "scriptGrades03": "Find a position where your body is supported. Feet flat on the floor. Hands resting wherever they want to rest.",
