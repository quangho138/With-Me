  "scriptColleagues21": "And one.",
  "@scriptColleagues21": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/21.mp3)."
  },
  "scriptColleagues22": "Resting here. Quiet. Safe.",
  "@scriptColleagues22": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/22.mp3)."
  },
  "scriptColleagues23": "Now let's move slowly through your body… and let the tension soften, wherever it's hiding.",
  "@scriptColleagues23": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/23.mp3)."
  },
  "scriptColleagues24": "Bring your attention to your jaw. Tension with others often gets clenched here. Let it hang loose.",
  "@scriptColleagues24": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/24.mp3)."
  },
  "scriptColleagues25": "Now your stomach. If there's a knot of frustration, breathe into it gently. Let it soften like warm wax.",
  "@scriptColleagues25": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/25.mp3)."
  },
  "scriptColleagues26": "Take a moment to search gently for anything still holding on… a tight brow, a clenched hand, a held breath. Wherever you find it, breathe in… and as you breathe out, let it melt away.",
  "@scriptColleagues26": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/26.mp3)."
  },
  "scriptColleagues27": "Down through your hips… your legs… all the way to your feet on the floor. Grounded. Supported. Nothing to hold up right now.",
  "@scriptColleagues27": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/27.mp3)."
  },
  "scriptColleagues28": "Your whole body… calm and heavy and safe. Enjoy this feeling for a few quiet breaths.",
  "@scriptColleagues28": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/28.mp3)."
  },
  "scriptColleagues29": "Imagine a clear stream flowing down a hillside. In its path are stones… some small, some large.",
  "@scriptColleagues29": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/29.mp3)."
  },
  "scriptColleagues30": "The water doesn't fight the stones. It flows around them, easily, and keeps moving. It stays clear. You can flow like that.",
  "@scriptColleagues30": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/30.mp3)."
  },
  "scriptColleagues31": "And as you rest here, let these words settle somewhere deep, where they can quietly work for you:",
  "@scriptColleagues31": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/31.mp3)."
  },
  "scriptColleagues32": "You can only control your part. That is enough.",
  "@scriptColleagues32": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/32.mp3)."
  },
  "scriptColleagues33": "Other people's moods are not your responsibility.",
  "@scriptColleagues33": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/33.mp3)."
  },
  "scriptColleagues34": "You can be kind and keep your boundaries.",
  "@scriptColleagues34": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/34.mp3)."
  },
  "scriptColleagues35": "Now, gently breathe out slowly through your mouth.",
  "@scriptColleagues35": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/35.mp3)."
  },
  "scriptColleagues36": "Take one slow breath… and silently say to yourself: Let it flow past.",
  "@scriptColleagues36": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/36.mp3)."
  },
  "scriptColleagues37": "Feel this calm gathering here. From now on, when a colleague's comment stings, or the office mood turns tense, you can do this again… take one breath… and this same calm will return, a little stronger each time.",
  "@scriptColleagues37": {
    "description": "Spoken line of Ease with Colleagues (recorded as meditate/colleagues/37.mp3)."
  },
  "scriptColleagues38": "Let it go now.",
  "@scriptColleagues38": {
