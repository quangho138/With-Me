  },
  "afterAnchorJobSecurity": "Press your feet down · “Solid ground.”",
  "@afterAnchorJobSecurity": {
    "description": "The anchor card after Steady Ground: the gesture and its words."
  },
  "scriptJobSecurity01": "Hi. I'm here with you.",
  "@scriptJobSecurity01": {
    "description": "Spoken line of Steady Ground (recorded as meditate/job_security/01.mp3)."
  },
  "scriptJobSecurity02": "Uncertainty about work can shake the ground under our feet. For these ten minutes, let's find solid ground again.",
