  },
  "scriptHomeReset21": "And one.",
  "@scriptHomeReset21": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/21.mp3)."
  },
  "scriptHomeReset22": "Resting here. Quiet. Safe.",
  "@scriptHomeReset22": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/22.mp3)."
  },
  "scriptHomeReset23": "Now let's move slowly through your body… and let the tension soften, wherever it's hiding.",
  "@scriptHomeReset23": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/23.mp3)."
  },
  "scriptHomeReset24": "Imagine warm water pouring slowly over you, from the top of your head down to your feet. Wherever it flows, tension melts.",
  "@scriptHomeReset24": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/24.mp3)."
  },
  "scriptHomeReset25": "Notice any place that still feels tight. Breathe into it… and let it join the rest of your body in rest.",
  "@scriptHomeReset25": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/25.mp3)."
  },
  "scriptHomeReset26": "Take a moment to search gently for anything still holding on… a tight brow, a clenched hand, a held breath. Wherever you find it, breathe in… and as you breathe out, let it melt away.",
  "@scriptHomeReset26": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/26.mp3)."
  },
  "scriptHomeReset27": "Down through your hips… your legs… all the way to your feet on the floor. Grounded. Supported. Nothing to hold up right now.",
  "@scriptHomeReset27": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/27.mp3)."
  },
  "scriptHomeReset28": "Your whole body… calm and heavy and safe. Enjoy this feeling for a few quiet breaths.",
  "@scriptHomeReset28": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/28.mp3)."
  },
  "scriptHomeReset29": "Imagine walking through your home and opening every window, one by one.",
  "@scriptHomeReset29": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/29.mp3)."
  },
  "scriptHomeReset30": "A fresh sea breeze moves through every room… clearing the air, carrying away the noise and the heaviness. Everything feels lighter. Cleaner. Calmer.",
  "@scriptHomeReset30": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/30.mp3)."
  },
  "scriptHomeReset31": "And as you rest here, let these words settle somewhere deep, where they can quietly work for you:",
  "@scriptHomeReset31": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/31.mp3)."
  },
  "scriptHomeReset32": "Home can hold a lot. Let it wait outside this moment.",
  "@scriptHomeReset32": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/32.mp3)."
  },
  "scriptHomeReset33": "You can create a calm corner, even in a busy home.",
  "@scriptHomeReset33": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/33.mp3)."
  },
  "scriptHomeReset34": "Rest is allowed here.",
  "@scriptHomeReset34": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/34.mp3)."
  },
  "scriptHomeReset35": "Now, gently let out one long, deep sigh.",
  "@scriptHomeReset35": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/35.mp3)."
  },
  "scriptHomeReset36": "Take one slow breath… and silently say to yourself: I'm at home in myself.",
  "@scriptHomeReset36": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/36.mp3)."
  },
  "scriptHomeReset37": "Feel this calm gathering here. From now on, when the house feels chaotic, or you need a moment to yourself, you can do this again… take one breath… and this same calm will return, a little stronger each time.",
  "@scriptHomeReset37": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/37.mp3)."
  },
  "scriptHomeReset38": "Let it go now.",
  "@scriptHomeReset38": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/38.mp3)."
  },
  "scriptHomeReset39": "Rest here now… nothing to do, nowhere to be… just letting the calm settle in, deeper with every breath.",
  "@scriptHomeReset39": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/39.mp3)."
  },
  "scriptHomeReset40": "Before we come back… Choose one small corner at home you can make calm today.",
  "@scriptHomeReset40": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/40.mp3)."
  },
  "scriptHomeReset41": "See yourself doing it calmly.",
  "@scriptHomeReset41": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/41.mp3)."
  },
  "scriptHomeReset42": "Now I'll count from one to five. With each number you'll feel more awake, more alert… bringing the calm back with you.",
  "@scriptHomeReset42": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/42.mp3)."
  },
  "scriptHomeReset43": "One… noticing what's beneath you.",
  "@scriptHomeReset43": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/43.mp3)."
  },
  "scriptHomeReset44": "Two… sounds of the room returning.",
  "@scriptHomeReset44": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/44.mp3)."
  },
  "scriptHomeReset45": "Three… a deeper breath, wiggling your fingers and toes.",
  "@scriptHomeReset45": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/45.mp3)."
  },
  "scriptHomeReset46": "Four… energy flowing back, clear and focused.",
  "@scriptHomeReset46": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/46.mp3)."
  },
  "scriptHomeReset47": "And five… eyes open when you're ready… calm, clear and ready.",
  "@scriptHomeReset47": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/47.mp3)."
  },
  "scriptHomeReset48": "Well done. Remember: I'm at home in myself. I'm here with you.",
  "@scriptHomeReset48": {
    "description": "Spoken line of Home Reset (recorded as meditate/home_reset/48.mp3)."
  },
  "meditateManagerTitle": "Confident with Your Manager",
  "@meditateManagerTitle": {
    "description": "A work meditation."
  },
  "afterAnchorManager": "Sit tall, chin level · “Grounded and clear.”",
  "@afterAnchorManager": {
    "description": "The anchor card after Confident with Your Manager: the gesture and its words."
  },
  "scriptManager01": "Hi. I'm here with you.",
  "@scriptManager01": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/01.mp3)."
  },
  "scriptManager02": "Meetings with a manager can make us feel small, even when we're doing well. For these ten minutes, you can stand tall inside yourself again.",
  "@scriptManager02": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/02.mp3)."
  },
  "scriptManager03": "Find a position where your body is supported. Feet flat on the floor. Hands resting wherever they want to rest.",
  "@scriptManager03": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/03.mp3)."
  },
  "scriptManager04": "Now let your eyes find one small point in front of you… and simply rest your gaze there.",
  "@scriptManager04": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/04.mp3)."
  },
  "scriptManager05": "Keep looking at it… and notice how your eyelids may start to feel a little heavier… a little slower to blink.",
  "@scriptManager05": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/05.mp3)."
  },
  "scriptManager06": "There's nothing you need to do right. Whenever they're ready… you can let your eyes close.",
  "@scriptManager06": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/06.mp3)."
  },
  "scriptManager07": "Let's slow the breath together. A longer out-breath tells your body you are safe.",
  "@scriptManager07": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/07.mp3)."
  },
  "scriptManager08": "Breathe in… two… three… four. And out… two… three… four… five… six.",
  "@scriptManager08": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/08.mp3)."
  },
  "scriptManager09": "Again. In… two… three… four. And slowly out… letting the shoulders fall… five… six.",
  "@scriptManager09": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/09.mp3)."
  },
  "scriptManager10": "Good. Let the breath find its own rhythm now.",
  "@scriptManager10": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/10.mp3)."
  },
  "scriptManager11": "In a moment I'll count down from ten to one. With each number, you can drift twice as deep into calm… and you don't have to try. Just listen.",
  "@scriptManager11": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/11.mp3)."
  },
  "scriptManager12": "Ten… letting go.",
  "@scriptManager12": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/12.mp3)."
  },
  "scriptManager13": "Nine… softer now.",
  "@scriptManager13": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/13.mp3)."
  },
  "scriptManager14": "Eight… the noise of the day moving further away.",
  "@scriptManager14": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/14.mp3)."
  },
  "scriptManager15": "Seven…",
  "@scriptManager15": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/15.mp3)."
  },
  "scriptManager16": "Six… deeper and calmer.",
  "@scriptManager16": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/16.mp3)."
  },
  "scriptManager17": "Five… halfway down, and comfortable.",
  "@scriptManager17": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/17.mp3)."
  },
  "scriptManager18": "Four…",
  "@scriptManager18": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/18.mp3)."
  },
  "scriptManager19": "Three… every breath carrying you down.",
  "@scriptManager19": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/19.mp3)."
  },
  "scriptManager20": "Two… almost there.",
  "@scriptManager20": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/20.mp3)."
  },
  "scriptManager21": "And one.",
  "@scriptManager21": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/21.mp3)."
  },
  "scriptManager22": "Resting here. Quiet. Safe.",
  "@scriptManager22": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/22.mp3)."
  },
  "scriptManager23": "Now let's move slowly through your body… and let the tension soften, wherever it's hiding.",
  "@scriptManager23": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/23.mp3)."
  },
  "scriptManager24": "Bring your attention to your throat. Let it open and soften… ready for a calm, clear voice.",
  "@scriptManager24": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/24.mp3)."
  },
  "scriptManager25": "Now your spine. Feel it lengthen gently, from your lower back to the top of your neck. Upright, but relaxed.",
  "@scriptManager25": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/25.mp3)."
  },
  "scriptManager26": "Take a moment to search gently for anything still holding on… a tight brow, a clenched hand, a held breath. Wherever you find it, breathe in… and as you breathe out, let it melt away.",
  "@scriptManager26": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/26.mp3)."
  },
  "scriptManager27": "Down through your hips… your legs… all the way to your feet on the floor. Grounded. Supported. Nothing to hold up right now.",
  "@scriptManager27": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/27.mp3)."
  },
  "scriptManager28": "Your whole body… calm and heavy and safe. Enjoy this feeling for a few quiet breaths.",
  "@scriptManager28": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/28.mp3)."
  },
  "scriptManager29": "Picture a tall tree on a windy cliff. Strong gusts come, and the tree bends, its leaves rustling.",
  "@scriptManager29": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/29.mp3)."
  },
  "scriptManager30": "But it doesn't break. It bends… and it returns to standing. Every storm makes its roots a little stronger. That tree is you.",
  "@scriptManager30": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/30.mp3)."
  },
  "scriptManager31": "And as you rest here, let these words settle somewhere deep, where they can quietly work for you:",
  "@scriptManager31": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/31.mp3)."
  },
  "scriptManager32": "Feedback is information, not a judgement of you.",
  "@scriptManager32": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/32.mp3)."
  },
  "scriptManager33": "You can speak clearly and calmly.",
  "@scriptManager33": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/33.mp3)."
  },
  "scriptManager34": "You've earned your place here.",
  "@scriptManager34": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/34.mp3)."
  },
  "scriptManager35": "Now, gently sit tall and let your chin rest level.",
  "@scriptManager35": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/35.mp3)."
  },
  "scriptManager36": "Take one slow breath… and silently say to yourself: Grounded and clear.",
  "@scriptManager36": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/36.mp3)."
  },
  "scriptManager37": "Feel this calm gathering here. From now on, before a one-to-one, a review, or when you're asked a difficult question, you can do this again… take one breath… and this same calm will return, a little stronger each time.",
  "@scriptManager37": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/37.mp3)."
  },
  "scriptManager38": "Let it go now.",
  "@scriptManager38": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/38.mp3)."
  },
  "scriptManager39": "Rest here now… nothing to do, nowhere to be… just letting the calm settle in, deeper with every breath.",
  "@scriptManager39": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/39.mp3)."
  },
  "scriptManager40": "Before we come back… Think of one thing you'd like to say clearly at your next conversation with your manager.",
  "@scriptManager40": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/40.mp3)."
  },
  "scriptManager41": "See yourself doing it calmly.",
  "@scriptManager41": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/41.mp3)."
  },
  "scriptManager42": "Now I'll count from one to five. With each number you'll feel more awake, more alert… bringing the calm back with you.",
  "@scriptManager42": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/42.mp3)."
  },
  "scriptManager43": "One… noticing what's beneath you.",
  "@scriptManager43": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/43.mp3)."
  },
  "scriptManager44": "Two… sounds of the room returning.",
  "@scriptManager44": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/44.mp3)."
  },
  "scriptManager45": "Three… a deeper breath, wiggling your fingers and toes.",
  "@scriptManager45": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/45.mp3)."
  },
  "scriptManager46": "Four… energy flowing back, clear and focused.",
  "@scriptManager46": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/46.mp3)."
  },
  "scriptManager47": "And five… eyes open when you're ready… calm, clear and ready.",
  "@scriptManager47": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/47.mp3)."
  },
  "scriptManager48": "Well done. Remember: Grounded and clear. I'm here with you.",
  "@scriptManager48": {
    "description": "Spoken line of Confident with Your Manager (recorded as meditate/manager/48.mp3)."
  },
