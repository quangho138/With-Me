  },
  "scriptHomeFull35": "And as you rest here, let these words settle somewhere deep, where they can quietly work for you:",
  "@scriptHomeFull35": {
    "description": "Spoken line of the ten-minute Home session (recorded as meditate/home_full/35.mp3)."
  },
